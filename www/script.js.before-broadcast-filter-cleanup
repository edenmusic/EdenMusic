async function getEdenLivePresence() {
    const { data: presenceRows, error: presenceError } = await supabase
        .from("live_signaling")
        .select("room_id, payload, created_at")
        .eq("message_type", "live-presence")
        .order("created_at", { ascending: false })
        .limit(1);

    if (presenceError) {
        console.error("EDEN LIVE PRESENCE LOOKUP ERROR:", presenceError);
        return null;
    }

    const presence = presenceRows?.[0];

    if (!presence?.room_id || presence?.payload?.active !== true) {
        return null;
    }

    const { data: endedRows, error: endedError } = await supabase
        .from("live_signaling")
        .select("room_id, payload, created_at")
        .eq("message_type", "live-ended")
        .eq("room_id", presence.room_id)
        .order("created_at", { ascending: false })
        .limit(1);

    if (endedError) {
        console.error("EDEN LIVE END LOOKUP ERROR:", endedError);
        return null;
    }

    const latestOffer = await supabase
        .from("live_signaling")
        .select("created_at")
        .eq("room_id", presence.room_id)
        .eq("message_type", "offer")
        .order("created_at", { ascending: false })
        .limit(1)
        .maybeSingle();

    if (latestOffer.error) {
        console.error("EDEN LIVE OFFER CHECK ERROR:", latestOffer.error);
        return null;
    }

    if (!latestOffer.data) {
        console.log("EDEN LIVE: No active WebRTC offer found for presence.");
        return null;
    }

    const latestEnded = endedRows?.[0];

    if (
        latestEnded &&
        new Date(latestEnded.created_at).getTime() >=
            new Date(presence.created_at).getTime()
    ) {
        console.log("EDEN LIVE: Latest live session has already ended.");
        return null;
    }

    return {
        roomId: presence.room_id,
        ...presence.payload
    };
}

window.getEdenLivePresence = getEdenLivePresence;

