    window.EDEN_REMOTE_APP_CONFIG = data;

    if (data.online_only === false) {
        console.warn("EDEN APP CONFIG: Remote online-only mode is disabled.");
    } else {
        console.log("EDEN APP CONFIG: Remote online-only mode is enabled.");
    }

    console.log("EDEN APP CONFIG LOADED:", data);

    return data;
}

