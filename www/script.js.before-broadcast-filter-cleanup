function openTikTokReel(video) {
    if (!supabase.auth.getSession) return;

    supabase.auth.getSession().then(({ data }) => {
        if (!data?.session?.user) {
            const count = getEdenGuestVideoCount();

            if (count >= 5) {
                alert("Guest limit reached. Create a Fan Account to keep watching.");
                return;
            }

            incrementEdenGuestVideoCount();
        }
    });


    window.currentTikTokReelVideo = video;

    const viewer = document.getElementById("tiktok-reel-viewer");
    const viewerVideo = document.getElementById("tiktok-reel-video");
    viewer.classList.remove("tiktok-reel-changing");
    void viewer.offsetWidth;
    const title = document.getElementById("tiktok-reel-title");
    const description = document.getElementById("tiktok-reel-description");
    const card = video?.closest(".reel-card");
    const likeButton = document.getElementById("tiktok-reel-like");
    const commentButton = document.getElementById("tiktok-reel-comment");
    const shareButton = document.getElementById("tiktok-reel-share");
    const videoId = card?.id?.replace(/^fun-vault-video-/, "");

    if (!viewer || !viewerVideo || !video) return;

    if (likeButton && videoId) {
        likeButton.onclick = () => toggleFunVaultLike(videoId);
    }

    if (commentButton && videoId) {
        commentButton.onclick = () => showFunVaultComments(videoId);
    }

    if (shareButton && videoId) {
        shareButton.onclick = () => shareFunVaultVideo(videoId);
    }

    viewer.classList.add("active");
    viewer.classList.add("tiktok-reel-changing");

    const reelSource = video.currentSrc || video.src || video.querySelector("source")?.src;

    if (!reelSource) {
        console.error("EDEN HOME REEL: No video source found.");
        return;
    }

    viewerVideo.pause();
    viewerVideo.removeAttribute("src");
    viewerVideo.load();
    viewerVideo.src = reelSource;
    viewerVideo.load();
    viewerVideo.currentTime = 0;
    viewerVideo.muted = window.tiktokReelMuted || false;

    if (tiktokMuteButton) {
        tiktokMuteButton.textContent = viewerVideo.muted ? "🔇" : "🔊";
    }

    if (title) {
        title.textContent = card?.querySelector(".reel-overlay h3")?.textContent || "";
    }

    if (description) {
        description.textContent = card?.querySelector(".reel-overlay p")?.textContent || "";
    }

    viewerVideo.onended = () => {
        const videos = Array.from(document.querySelectorAll("#public-reels-container .public-reel-video"));
        const currentIndex = videos.indexOf(window.currentTikTokReelVideo);
        const nextVideo = videos[currentIndex + 1];

        if (nextVideo) {
            openTikTokReel(nextVideo);
        } else {
            closeTikTokReel();
        }
    };

    viewer.classList.remove("tiktok-reel-changing");
    viewerVideo.play().catch(() => {});
    document.body.style.overflow = "hidden";
}

function closeTikTokReel() {
    const viewer = document.getElementById("tiktok-reel-viewer");
    const video = document.getElementById("tiktok-reel-video");

    if (video) {
        video.pause();
        video.removeAttribute("src");
        video.load();
        video.onended = null;
    }

    if (viewer) {
        viewer.classList.remove("active");
    }

    window.currentTikTokReelVideo = null;
    document.body.style.overflow = "";
}

