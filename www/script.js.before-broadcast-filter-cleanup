async function uploadEdenLauncherIcon(file, round = false) {
    if (!file) {
        console.error(
            "EDEN LAUNCHER ICON: No file selected."
        );
        return null;
    }

    const fileName = round
        ? "ic_launcher_round.png"
        : "ic_launcher.png";

    const path =
        `${EDEN_APP_ASSETS.launcherIconFolder}/${fileName}`;

    const { data, error } = await supabase.storage
        .from(EDEN_APP_ASSETS.bucket)
        .upload(path, file, {
            upsert: true,
            contentType: "image/png"
        });

    if (error) {
        console.error(
            "EDEN LAUNCHER ICON UPLOAD ERROR:",
            error
        );
        return null;
    }

    console.log(
        "EDEN LAUNCHER ICON UPLOADED:",
        data
    );

    return data;
}

