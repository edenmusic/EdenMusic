async function updateFunVaultVideo(videoId) {
    if (!videoId) return;

    const title = document.getElementById("fun-vault-title")?.value.trim();
    const description = document.getElementById("fun-vault-description")?.value.trim() || "";
    const isPublished = document.getElementById("fun-vault-published")?.checked ?? true;
    const message = document.getElementById("fun-vault-save-message");

    if (!title) {
        if (message) message.textContent = "Please enter a video title.";
        return;
    }

    const videoFile = document.getElementById("fun-vault-video-input")?.files?.[0];

    let videoUrl;

    if (videoFile) {
        const { data: oldVideo } = await supabase
            .from("fun_vault_videos")
            .select("video_url")
            .eq("id", videoId)
            .single();

        const fileExtension = videoFile.name.split(".").pop()?.toLowerCase() || "mp4";
        const { data: { user } } = await supabase.auth.getUser();
        if (!user) return;

        const filePath = `${user.id}/${crypto.randomUUID()}.${fileExtension}`;

        const { error: uploadError } = await supabase.storage
            .from("fun-vault-videos")
            .upload(filePath, videoFile, {
                upsert: false,
                contentType: videoFile.type
            });

        if (uploadError) {
            console.error("Replacement video upload error:", uploadError);
            if (message) message.textContent = "Could not upload replacement video.";
            return;
        }

        const { data: publicUrlData } = supabase.storage
            .from("fun-vault-videos")
            .getPublicUrl(filePath);

        videoUrl = publicUrlData?.publicUrl;

        if (videoUrl && oldVideo?.video_url) {
            const marker = "/storage/v1/object/public/fun-vault-videos/";
            if (oldVideo.video_url.includes(marker)) {
                const oldPath = decodeURIComponent(oldVideo.video_url.split(marker)[1]);
                await supabase.storage.from("fun-vault-videos").remove([oldPath]);
            }
        }
    }

    const updateData = {
        title,
        description,
        is_published: isPublished
    };

    if (videoUrl) updateData.video_url = videoUrl;

    const { error } = await supabase
        .from("fun_vault_videos")
        .update(updateData)
        .eq("id", videoId);

    if (error) {
        console.error("Update Fun Vault video error:", error);
        if (message) message.textContent = "Could not update video.";
        return;
    }

    if (message) message.textContent = "Fun Vault video updated successfully!";

    document.getElementById("fun-vault-title").value = "";
    document.getElementById("fun-vault-description").value = "";
    document.getElementById("fun-vault-video-input").value = "";

    const publishedInput = document.getElementById("fun-vault-published");
    if (publishedInput) publishedInput.checked = true;

    const button = document.getElementById("save-fun-vault-button");
    if (button) {
        button.textContent = "Upload Fun Vault Video";
        button.onclick = saveFunVaultVideo;
    }

    await loadFunVaultVideos();
}

window.editFunVaultVideo = editFunVaultVideo;
window.updateFunVaultVideo = updateFunVaultVideo;

async function saveFunVaultVideo() {
    const titleInput = document.getElementById("fun-vault-title");
    const descriptionInput = document.getElementById("fun-vault-description");
    const videoInput = document.getElementById("fun-vault-video-input");
    const publishedInput = document.getElementById("fun-vault-published");
    const message = document.getElementById("fun-vault-save-message");
    const button = document.getElementById("save-fun-vault-button");

    const title = titleInput?.value.trim();
    const description = descriptionInput?.value.trim() || "";
    const videoFile = videoInput?.files?.[0];
    const isPublished = publishedInput?.checked ?? true;

    if (!title) {
        if (message) message.textContent = "Please enter a video title.";
        return;
    }

    if (!videoFile) {
        if (message) message.textContent = "Please choose a video file.";
        return;
    }

    const { data: { user }, error: userError } = await supabase.auth.getUser();

    if (userError || !user) {
        if (message) message.textContent = "Developer session not found.";
        return;
    }

    if (button) {
        button.disabled = true;
        button.textContent = "Uploading...";
    }

    const fileExtension =
        videoFile.name.split(".").pop()?.toLowerCase() || "mp4";

    const filePath =
        `${user.id}/${crypto.randomUUID()}.${fileExtension}`;

    const { error: uploadError } = await supabase.storage
        .from("fun-vault-videos")
        .upload(filePath, videoFile, {
            upsert: false,
            contentType: videoFile.type
        });

    if (uploadError) {
        console.error("Fun Vault upload error:", uploadError);

        if (message) {
            message.textContent = "Could not upload the video.";
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Upload Fun Vault Video";
        }

        return;
    }

    const { data: publicUrlData } = supabase.storage
        .from("fun-vault-videos")
        .getPublicUrl(filePath);

    const videoUrl = publicUrlData?.publicUrl;

    if (!videoUrl) {
        if (message) {
            message.textContent = "Video uploaded, but its URL could not be created.";
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Upload Fun Vault Video";
        }

        return;
    }

    const { error: insertError } = await supabase
        .from("fun_vault_videos")
        .insert({
            title,
            description,
            video_url: videoUrl,
            thumbnail_url: "",
            is_published: isPublished
        });

    if (insertError) {
        console.error("Save Fun Vault video error:", insertError);

        if (message) {
            message.textContent = "Video uploaded, but its information could not be saved.";
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Upload Fun Vault Video";
        }

        return;
    }

    if (message) {
        message.textContent = "Fun Vault video uploaded successfully!";
    }

    if (titleInput) titleInput.value = "";
    if (descriptionInput) descriptionInput.value = "";
    if (videoInput) videoInput.value = "";

    if (button) {
        button.disabled = false;
        button.textContent = "Upload Fun Vault Video";
    }

    await loadFunVaultVideos();
}

async function deleteFunVaultVideo(videoId) {
    if (!videoId) return;

    const confirmed = window.confirm(
        "Delete this Fun Vault video?"
    );

    if (!confirmed) return;

    const { data: video, error: videoError } = await supabase
        .from("fun_vault_videos")
        .select("video_url")
        .eq("id", videoId)
        .single();

    if (videoError) {
        console.error("Find Fun Vault video error:", videoError);
        return;
    }

    const videoUrl = video?.video_url || "";
    const marker = "/storage/v1/object/public/fun-vault-videos/";

    if (videoUrl.includes(marker)) {
        const filePath = decodeURIComponent(
            videoUrl.split(marker)[1]
        );

        const { error: storageError } = await supabase.storage
            .from("fun-vault-videos")
            .remove([filePath]);

        if (storageError) {
            console.error("Delete Fun Vault file error:", storageError);
        }
    }

    const { error: deleteError } = await supabase
        .from("fun_vault_videos")
        .delete()
        .eq("id", videoId);

    if (deleteError) {
        console.error("Delete Fun Vault database record error:", deleteError);
        return;
    }

