async function loadPublicReels() {
    const container = document.getElementById("public-reels-container");
    const fanVaultContainer = document.getElementById("fan-vault-videos");
    if (!container) return;

    const { data: vaultVideos, error: vaultError } = await supabase
        .from("fun_vault_videos")
        .select("id, title, description, video_url, thumbnail_url, created_at")
        .eq("is_published", true);

    const { data: linkedVideos, error: linkedError } = await supabase
        .from("linked_account_content")
        .select("id, title, description, video_url, thumbnail_url, created_at, destination")
        .eq("status", "approved")
        .in("destination", ["home", "both"])

    if (vaultError || linkedError) {
        console.error("Public video load error:", vaultError || linkedError);
        container.innerHTML =
            '<p class="dashboard-empty">Could not load reels.</p>';
        return;
    }

    const videos = [
        ...(vaultVideos || []).map(video => ({ ...video, sourceLabel: "FUN VAULT" })),
        ...(linkedVideos || []).map(video => ({ ...video, sourceLabel: "LINKED ACCOUNT" }))
    ]
    .sort((a, b) => new Date(b.created_at) - new Date(a.created_at))
    .slice(0, 5);

    if (!videos.length) {
        container.innerHTML =
            '<p class="dashboard-empty">No reels available yet.</p>';
        return;
