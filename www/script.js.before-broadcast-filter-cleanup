async function linkSocialAccount() {
    const platform = document.getElementById("linked-social-platform")?.value;
    const accountUrl = document.getElementById("linked-social-account-url")?.value.trim();
    const username = document.getElementById("linked-social-account-username")?.value.trim() || null;

    if (!accountUrl) {
        showMessage("Enter the TikTok or Instagram profile URL.");
        return;
    }

    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
        showMessage("You must be logged in.");
        return;
    }

    const { error } = await supabase
        .from("linked_social_accounts")
        .insert({
            user_id: user.id,
            platform,
            account_url: accountUrl,
            account_username: username
        });

    if (error) {
        console.error("Link social account error:", error);
        showMessage("Could not link account.");
        return;
    }

    document.getElementById("linked-social-account-url").value = "";
    document.getElementById("linked-social-account-username").value = "";

    showMessage(`${platform} account linked.`);
    await loadLinkedSocialAccounts();
}

async function loadLinkedSocialAccounts() {
    const container = document.getElementById("linked-social-accounts-list");
    if (!container) return;

    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;

    const { data, error } = await supabase
        .from("linked_social_accounts")
        .select("*")
        .eq("user_id", user.id)
        .order("created_at", { ascending: false });

    if (error) {
        console.error("Load linked social accounts error:", error);
        return;
    }

    container.innerHTML = data?.length
        ? data.map(account => `
            <div class="developer-release-card">
                <div>
                    <span class="eyebrow">${account.platform.toUpperCase()}</span>
                    <strong>${account.account_username || account.account_url}</strong>
                    <p>${account.account_url}</p>
                </div>
            </div>
        `).join("")
        : "<p>No linked accounts yet.</p>";
}

