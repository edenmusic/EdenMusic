async function subscribeEdenLiveComments(roomId) {
    if (!roomId) return;

    if (edenLiveCommentsChannel) {
        await supabase.removeChannel(edenLiveCommentsChannel);
        edenLiveCommentsChannel = null;
    }

    edenLiveCommentsChannel = supabase
        .channel(`eden-live-comments-${roomId}`)
        .on(
            "postgres_changes",
            {
                event: "INSERT",
                schema: "public",
                table: "live_comments",
                filter: `room_id=eq.${roomId}`
            },
            payload => {
                console.log(
                    "EDEN LIVE COMMENT:",
                    payload.new
                );

                renderEdenLiveComment(payload.new);
            }
        )
        .subscribe(status => {
            console.log(
                "EDEN LIVE COMMENTS STATUS:",
                status
            );
        });

    window.edenLiveCommentsChannel =
        edenLiveCommentsChannel;
}

