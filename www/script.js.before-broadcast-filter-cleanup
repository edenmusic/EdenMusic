async function endEdenLive() {
    if (!window.edenLiveIsArtist) return;

    const roomId =
        window.edenLiveCurrentRoomId ||
        edenLiveState?.roomId;

    if (!roomId) return;

    const confirmed = confirm(
        "End this live session for everyone?"
    );

    if (!confirmed) return;

    const endedAt = new Date().toISOString();

    try {
        await supabase
            .from("live_signaling")
            .insert({
                room_id: roomId,
                message_type: "live-ended",
                payload: { endedAt }
            });

        edenLiveState = {
            ...edenLiveState,
            active: false,
            roomId,
            endedAt
        };

        await publishEdenLivePresence();

        if (edenLivePeerConnection) {
            edenLivePeerConnection.close();
            edenLivePeerConnection = null;
        }

        if (window.edenLiveAnswerChannel) {
            await supabase.removeChannel(window.edenLiveAnswerChannel);
            window.edenLiveAnswerChannel = null;
        }

        if (window.edenLiveBroadcasterIceChannel) {
            await supabase.removeChannel(window.edenLiveBroadcasterIceChannel);
            window.edenLiveBroadcasterIceChannel = null;
        }

        if (edenLiveSignalingChannel) {
            await supabase.removeChannel(edenLiveSignalingChannel);
            edenLiveSignalingChannel = null;
        }

        if (edenLiveCommentsChannel) {
            await supabase.removeChannel(edenLiveCommentsChannel);
            edenLiveCommentsChannel = null;
        }

        stopAppLivePreview();
        setEdenLiveFullscreen(false);

        document.body.classList.remove(
            "eden-live-active",
            "eden-live-artist",
            "eden-live-fan"
        );

        window.edenLiveCurrentRoomId = null;
        edenLiveRoomId = null;
        window.edenLiveIsArtist = false;

        edenLiveState = {
            ...edenLiveState,
            active: false,
            roomId: null
        };

        updateEdenFanLiveStatus();

        const message = document.getElementById("fan-vault-live-save-message");
        if (message) {
            message.textContent = "Live session ended. Eden Music is now offline.";
        }

        console.log("EDEN LIVE ENDED:", roomId);
    } catch (error) {
        console.error("EDEN LIVE END ERROR:", error);

        const message = document.getElementById("fan-vault-live-save-message");
        if (message) {
            message.textContent = "Unable to end the live session completely.";
        }
    }
}

