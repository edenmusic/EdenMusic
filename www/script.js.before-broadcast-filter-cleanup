function openDeveloperDashboardSection(sectionName) {
    const section = developerDashboardSections[sectionName];
    if (!section) return;

    const menu = document.getElementById("developer-dashboard-menu");
    const header = document.getElementById("developer-dashboard-header");
    const back = document.getElementById("developer-dashboard-back");
    const title = document.getElementById("developer-dashboard-section-title");

    Object.values(developerDashboardSections).forEach(item => {
        const element = document.getElementById(item.id);
        if (element) element.classList.remove("active");
    });

    const target = document.getElementById(section.id);
    if (target) target.classList.add("active");

    if (menu) menu.style.display = "none";
    if (header) header.style.display = "none";
    if (back) back.style.display = "block";
    if (title) title.textContent = section.title;

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

function closeDeveloperDashboardSection() {
    const menu = document.getElementById("developer-dashboard-menu");
    const header = document.getElementById("developer-dashboard-header");
    const back = document.getElementById("developer-dashboard-back");

    Object.values(developerDashboardSections).forEach(item => {
        const element = document.getElementById(item.id);
        if (element) element.classList.remove("active");
    });

    if (menu) menu.style.display = "";
    if (header) header.style.display = "";
    if (back) back.style.display = "none";

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

window.openDeveloperDashboardSection = openDeveloperDashboardSection;
window.closeDeveloperDashboardSection = closeDeveloperDashboardSection;


async function loadFanVaultDashboardEvents() {
    const container = document.getElementById("fan-vault-dashboard-events");
    if (!container) return;

    const { data, error } = await supabase
        .from("upcoming_events")
        .select("id, title, description, event_date, broadcast_live")
        .order("event_date", { ascending: true });

    if (error) {
        console.error("EDEN DASHBOARD UPCOMING EVENTS ERROR:", error);
        container.innerHTML =
            '<p class="dashboard-empty">Unable to load upcoming events.</p>';
        return;
    }

    if (!data || data.length === 0) {
        container.innerHTML =
            '<p class="dashboard-empty">No upcoming events yet.</p>';
        return;
    }

    container.innerHTML = data.map(event => {
        const date = new Date(event.event_date);

        return `
            <div class="dashboard-list-item">
                <div>
                    <strong>${event.title || "Untitled Event"}</strong>
                    <p>${event.description || "No description."}</p>
                    <small>${date.toLocaleString()}</small>
                </div>
                <span>${event.broadcast_live ? "LIVE BROADCAST" : "SCHEDULED"}</span>
            </div>
        `;
    }).join("");
}

