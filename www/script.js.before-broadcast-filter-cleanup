async function uploadFanAvatar(file) {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user || !file) return;

    const message = document.getElementById("fan-account-message");
    if (message) message.textContent = "Uploading profile picture...";

    const extension = file.name.split(".").pop()?.toLowerCase() || "jpg";
    const filePath = session.user.id + "/avatar." + extension;

    const { error: uploadError } = await supabase.storage
        .from("profiles-avatars")
        .upload(filePath, file, { upsert: true });

    if (uploadError) {
        console.error("Fan avatar upload error:", uploadError);
        if (message) message.textContent = "Could not upload profile picture.";
        return;
    }

    const { data: publicUrlData } = supabase.storage
        .from("profiles-avatars")
        .getPublicUrl(filePath);

    const avatarUrl = publicUrlData.publicUrl;

    const { error: profileError } = await supabase
        .from("profiles")
        .update({ avatar_url: avatarUrl })
        .eq("user_id", session.user.id);

    if (profileError) {
        console.error("Fan avatar profile update error:", profileError);
        if (message) message.textContent = "Picture uploaded, but profile update failed.";
        return;
    }

    const avatar = document.getElementById("fan-account-avatar");
    const placeholder = document.getElementById("fan-account-avatar-placeholder");

    if (avatar) {
        avatar.src = avatarUrl;
        avatar.style.display = "block";
    }

    if (placeholder) placeholder.style.display = "none";
    if (message) message.textContent = "Profile picture updated.";
}

function setupFanAvatarUpload() {
    const input = document.getElementById("fan-avatar-file");
    if (!input || input.dataset.bound === "true") return;

    input.dataset.bound = "true";
    input.addEventListener("change", () => {
        const file = input.files?.[0];
        if (file) uploadFanAvatar(file);
    });
}

