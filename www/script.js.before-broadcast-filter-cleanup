/* ================= FAN VAULT REEL AUTO PLAY ================= */

function setupFanVaultReelAutoplay() {
    const container = document.querySelector("#fan-vault-screen .reels-container");

    if (!container) return;

    const videos = container.querySelectorAll(".reel-video");

    if (!videos.length) return;

    const observer = new IntersectionObserver(
        entries => {
            entries.forEach(entry => {
                const video = entry.target;

                if (entry.isIntersecting && entry.intersectionRatio >= 0.7) {
                    videos.forEach(otherVideo => {
                        if (otherVideo !== video) {
                            otherVideo.pause();
                        }
                    });

                    video.play().catch(() => {});
                } else {
                    video.pause();
                }
            });
        },
        {
            root: container,
            threshold: [0.7]
        }
    );

    videos.forEach(video => {
        observer.observe(video);
    });
}

window.setupFanVaultReelAutoplay = setupFanVaultReelAutoplay;


/* ================= FAN VAULT REEL TAP TO PLAY ================= */

function setupFanVaultReelTap() {
    const container = document.querySelector("#fan-vault-screen .reels-container");

    if (!container) return;

    const videos = container.querySelectorAll(".reel-video");

    videos.forEach(video => {
        video.addEventListener("click", event => {
            if (event.target !== video) return;

            if (video.paused) {
                video.play().catch(() => {});
            } else {
                video.pause();
            }
        });
    });
}

window.setupFanVaultReelTap = setupFanVaultReelTap;


