async function createMerchandise() {
    const name = document.getElementById("merch-name")?.value.trim();
    const description = document.getElementById("merch-description")?.value.trim();
    const price = Number(document.getElementById("merch-price")?.value);
    const currency = document.getElementById("merch-currency")?.value.trim() || "KES";
    const imageFile = document.getElementById("merch-image-file")?.files[0];
    const stock = Number(document.getElementById("merch-stock")?.value || 0);
    const isPreorder = document.getElementById("merch-is-preorder")?.checked || false;
    const isAvailable = document.getElementById("merch-is-available")?.checked ?? true;
    const message = document.getElementById("merch-save-message");

    if (!name || Number.isNaN(price) || !imageFile) {
        if (message) message.textContent = "Name, price, and image are required.";
        return;
    }

    const safeName = imageFile.name.replace(/[^a-zA-Z0-9.-]/g, "_");
    const imagePath = "merchandise/" + Date.now() + "_" + safeName;

    const { error: imageUploadError } = await supabase
        .storage
        .from("song")
        .upload(imagePath, imageFile, {
            cacheControl: "3600",
            upsert: false
        });

    if (imageUploadError) {
        console.error("Merchandise image upload error:", imageUploadError);
        if (message) message.textContent = "Could not upload merchandise image.";
        return;
    }

    const { data: imagePublicData } = supabase
        .storage
        .from("song")
        .getPublicUrl(imagePath);

    const imageUrl = imagePublicData.publicUrl;

    const { error } = await supabase
        .from("merchandise")
        .insert({
            name,
            description: description || null,
            price,
            currency,
            image_url: imageUrl || null,
            stock,
            is_preorder: isPreorder,
            is_available: isAvailable
        });

    if (error) {
        console.error("Create merchandise error:", error);
        if (message) message.textContent = "Could not create merchandise.";
        return;
    }

