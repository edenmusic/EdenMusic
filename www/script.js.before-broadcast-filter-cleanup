    if (!name || Number.isNaN(price) || !imageFile) {
        if (message) message.textContent = "Name, price, and image are required.";
        return;
    }

    const { error } = await supabase
        .from("merchandise")
        .update({
            name,
            description: description || null,
            price,
            currency,
            image_url: imageUrl || null,
            stock,
            is_preorder: isPreorder,
            is_available: isAvailable
        })
        .eq("id", merchId);

    if (error) {
        console.error("Update merchandise error:", error);
        if (message) message.textContent = "Could not update merchandise.";
        return;
    }

    if (message) message.textContent = "Merchandise updated successfully.";

    clearMerchandiseForm();

    const button = document.querySelector("#developer-merch-controls button");

    if (button) {
        button.textContent = "🛍️ Add Merchandise";
        button.onclick = createMerchandise;
