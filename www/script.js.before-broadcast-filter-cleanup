            console.error("Save payment reference error:", referenceError);
            showMessage("Could not prepare payment.");
            return;
        }

        const paymentResponse = await supabase.functions.invoke("create-payment", {
            body: {
                email: user.email,
                amount: Math.round(totalAmount * 100),
                reference: paymentReference,
                callback_url: `${window.location.origin}/`
            }
        });

        if (paymentResponse.error || !paymentResponse.data?.status || !paymentResponse.data?.data?.authorization_url) {
            console.error("Paystack initialization error:", paymentResponse.error || paymentResponse.data);
            showMessage("Could not start payment. Your order remains pending.");
            return;
        }

        console.log("Paystack payment initialized:", paymentResponse.data.data.reference);
        window.location.href = paymentResponse.data.data.authorization_url;
    });
