        .from("merchandise")
        .delete()
        .eq("id", merchId);

    if (error) {
        console.error("Delete merchandise error:", error);
        showMessage("Could not delete merchandise.");
        return;
    }

    showMessage("Merchandise deleted.");

    await loadDeveloperMerchandise();
    await loadFanVaultMerchandise();
}

