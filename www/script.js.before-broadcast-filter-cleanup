async function verifyMerchPayment(reference) {
    try {
        const { data, error } = await supabase.functions.invoke("verify-payment", {
            body: { reference }
        });

        if (error) {
            console.error("Payment verification request failed:", error);
            showMessage("Payment verification failed. Please check your order status.");
            return false;
        }

        if (!data?.success || data?.data?.status !== "success") {
            console.error("Payment verification failed:", data);
            showMessage("Payment could not be verified.");
            return false;
        }

        console.log("Payment verified successfully:", reference);
        return true;
    } catch (error) {
        console.error("Payment verification error:", error);
        showMessage("Payment verification failed. Please try again.");
        return false;
    }
}

