/* ================= TIKTOK VIEWER SWIPE ================= */

let tiktokTouchStartY = 0;
let tiktokTouchEndY = 0;

function setupTikTokSwipe() {
    const viewer = document.getElementById("tiktok-reel-viewer");

    if (!viewer || viewer.dataset.swipeBound === "true") return;

    viewer.dataset.swipeBound = "true";

    viewer.addEventListener("touchstart", event => {
        tiktokTouchStartY = event.touches[0].clientY;
    }, { passive: true });

    viewer.addEventListener("touchend", event => {
        tiktokTouchEndY = event.changedTouches[0].clientY;

        const distance = tiktokTouchStartY - tiktokTouchEndY;

        if (Math.abs(distance) < 80) return;

        const videos = Array.from(
            document.querySelectorAll("#public-reels-container .public-reel-video")
        );

        const currentIndex = videos.indexOf(window.currentTikTokReelVideo);

        if (currentIndex === -1) return;

        if (distance > 0) {
            const nextVideo = videos[currentIndex + 1];
            if (nextVideo) openTikTokReel(nextVideo);
        } else {
            const previousVideo = videos[currentIndex - 1];
            if (previousVideo) openTikTokReel(previousVideo);
        }
    }, { passive: true });
}

window.setupTikTokSwipe = setupTikTokSwipe;
setupTikTokSwipe();


/* ================= TIKTOK VIEWER KEYBOARD CONTROLS ================= */

document.addEventListener("keydown", event => {
    const viewer = document.getElementById("tiktok-reel-viewer");
    const video = document.getElementById("tiktok-reel-video");

    if (!viewer?.classList.contains("active") || !video) return;

    const videos = Array.from(document.querySelectorAll("#public-reels-container .public-reel-video"));

    const currentVideo = window.currentTikTokReelVideo;
    const currentIndex = videos.indexOf(currentVideo);

    if (event.key === "Escape") {
        closeTikTokReel();
        return;
    }

    if (event.key === " ") {
        event.preventDefault();

        if (video.paused) {
            video.play().catch(() => {});
        } else {
            video.pause();
        }

        return;
    }

    if (event.key === "ArrowDown") {
        event.preventDefault();

        const nextVideo = videos[currentIndex + 1];

        if (nextVideo) {
            openTikTokReel(nextVideo);
        }

        return;
    }

    if (event.key === "ArrowUp") {
        event.preventDefault();

        const previousVideo = videos[currentIndex - 1];

        if (previousVideo) {
            openTikTokReel(previousVideo);
        }
    }
});


