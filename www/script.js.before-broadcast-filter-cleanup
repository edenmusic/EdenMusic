function setupFanVaultDoubleTapLike() {
    const container = document.querySelector("#fan-vault-screen .reels-container");

    if (!container) return;

    const videos = container.querySelectorAll(".reel-video");

    videos.forEach(video => {
        let lastTap = 0;

        video.addEventListener("touchend", () => {
            const now = Date.now();

            if (now - lastTap < 300) {
                const card = video.closest(".reel-card");
                const likeButton = card?.querySelector(
                    '.reel-engagement button[onclick^="toggleFunVaultLike"]'
                );

                if (likeButton) {
                    likeButton.click();
                }
            }

            lastTap = now;
        });
    });
}

