    }

    const { error } = await supabase
        .from("upcoming_events")
        .insert({
            title,
            description: description || null,event_date: new Date(scheduledAt).toISOString(),
            broadcast_live: broadcastLive,
            
        });

    if (error) {
        console.error("EDEN LIVE EVENT CREATE ERROR:", error);
        const message = document.getElementById("fan-vault-event-save-message");
        if (message) message.textContent = "Could not create live event.";
        return;
    }

