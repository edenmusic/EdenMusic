async function saveDeveloperProfile() {
    const displayNameInput = document.getElementById("profile-display-name");
    const bioInput = document.getElementById("profile-bio");
    const avatarFileInput = document.getElementById("profile-avatar-file");
    const message = document.getElementById("profile-save-message");
    const button = document.getElementById("save-profile-button");

    const displayName = displayNameInput?.value.trim();
    const bio = bioInput?.value.trim() || "";

    if (!displayName) {
        if (message) message.textContent = "Please enter a display name.";
        return;
    }

    const { data: { user }, error: userError } = await supabase.auth.getUser();
    const userId = user?.id || developerUserId;

    if (userError || !userId) {
        console.error("Developer user error:", userError);
        if (message) message.textContent = "Developer session not found.";
        return;
    }

    if (button) {
        button.disabled = true;
        button.textContent = "Saving...";
    }

    let avatarUrl = null;

    const { data: currentProfile } = await supabase
        .from("profiles")
        .select("avatar_url")
        .eq("user_id", userId)
        .single();

    avatarUrl = currentProfile?.avatar_url || null;

    const avatarFile = avatarFileInput?.files?.[0];

    if (avatarFile) {
        const fileExtension = avatarFile.name.split(".").pop()?.toLowerCase() || "jpg";
        const filePath = `${userId}/avatar.${fileExtension}`;

        const { error: uploadError } = await supabase.storage
            .from("profiles-avatars")
            .upload(filePath, avatarFile, {
                upsert: true,
                contentType: avatarFile.type
            });

        if (uploadError) {
            console.error("Avatar upload error:", uploadError);

            if (message) message.textContent = "Could not upload profile picture.";

            if (button) {
                button.disabled = false;
                button.textContent = "Save Profile";
            }

            return;
        }

        const { data: publicUrlData } = supabase.storage
            .from("profiles-avatars")
            .getPublicUrl(filePath);

        avatarUrl = publicUrlData?.publicUrl || avatarUrl;
    }

    const { error: profileError } = await supabase
        .from("profiles")
        .update({
            display_name: displayName,
            bio: bio,
            avatar_url: avatarUrl
        })
        .eq("user_id", userId);

    if (profileError) {
        console.error("Save developer profile error:", profileError);

        if (message) message.textContent = "Could not save the profile.";

        if (button) {
            button.disabled = false;
            button.textContent = "Save Profile";
        }

        return;
    }

    const rows = Array.from(
        document.querySelectorAll(".social-link-editor-row")
    )
    .map(row => {
        const platform = row
            .querySelector(".social-platform-input")
            ?.value.trim();

        const url = row
            .querySelector(".social-url-input")
            ?.value.trim();

        return {
            platform_name: platform,
            profile_url: url
        };
    })
    .filter(link => link.platform_name && link.profile_url);

    const { error: deleteError } = await supabase
        .from("profile_social_links")
        .delete()
        .eq("profile_user_id", userId);

    if (deleteError) {
        console.error("Delete old social links error:", deleteError);

        if (message) {
            message.textContent = "Profile saved, but old social links could not be updated.";
        }
    } else if (rows.length) {
        const { error: insertError } = await supabase
            .from("profile_social_links")
            .insert(
                rows.map(link => ({
                    profile_user_id: userId,
                    platform_name: link.platform_name,
                    profile_url: link.profile_url
                }))
            );

        if (insertError) {
            console.error("Save social links error:", insertError);

            if (message) {
                message.textContent =
                    "Profile saved, but social links could not be saved.";
            }

            if (button) {
                button.disabled = false;
                button.textContent = "Save Profile";
            }

            return;
        }
    }

    updateDeveloperAvatar(avatarUrl);

    if (message) message.textContent = "Profile saved successfully!";

    if (button) {
        button.disabled = false;
        button.textContent = "Save Profile";
    }

    if (avatarFileInput) {
        avatarFileInput.value = "";
    }
}

async function loadPublicProfile() {
    const developerAccess = document.getElementById("developer-access-section");
    const fanAccountProfile = document.getElementById("fan-account-profile-section");
    const fanAccessSection = document.querySelector(".fan-access-section");

    if (developerAccess) developerAccess.style.display = "none";
    if (fanAccountProfile) fanAccountProfile.style.display = "none";
    if (fanAccessSection) fanAccessSection.style.display = "block";

    const { data: { session } } = await supabase.auth.getSession();

    if (session?.user) {
        const { data: currentProfile, error: currentProfileError } = await supabase
            .from("profiles")
            .select("role, display_name")
            .eq("user_id", session.user.id)
            .maybeSingle();

        if (!currentProfileError && ["developer", "fan"].includes(currentProfile?.role)) {
            if (developerAccess) developerAccess.style.display = "block";
            const profileLogout = document.getElementById("profile-logout-button");
            if (profileLogout) profileLogout.style.display = "block";
            if (fanAccessSection) fanAccessSection.style.display = "none";
        }

        if (!currentProfileError && currentProfile?.role === "fan") {
            if (fanAccountProfile) fanAccountProfile.style.display = "block";
            if (fanAccessSection) fanAccessSection.style.display = "none";

            const fanName = document.getElementById("fan-profile-name");
            const fanEmail = document.getElementById("fan-profile-email");

            if (fanName) {
                fanName.textContent = currentProfile.display_name || "Fan Account";
            }

            if (fanEmail) {
                fanEmail.textContent = session.user.email || "";
            }
        }
    }

    const nameElement = document.getElementById("public-profile-name");
    const bioElement = document.getElementById("public-profile-bio");
    const avatarImage = document.getElementById("public-profile-avatar");
    const avatarPlaceholder = document.getElementById("public-profile-avatar-placeholder");
    const socialContainer = document.getElementById("public-social-links");

    if (!nameElement || !bioElement || !socialContainer) return;

    const { data: profile, error } = await supabase
        .from("profiles")
        .select("user_id, display_name, bio, avatar_url")
        .eq("role", "developer")
        .limit(1)
        .maybeSingle();

    if (error) {
        console.error("Public profile error:", error);
        return;
    }

    if (!profile) return;

    nameElement.textContent = profile.display_name || "Eden";
    bioElement.textContent = profile.bio || "R&B Artist & Producer";

    if (profile.avatar_url && avatarImage && avatarPlaceholder) {
        avatarImage.src = profile.avatar_url;
        avatarImage.style.display = "block";
        avatarPlaceholder.style.display = "none";
    } else if (avatarImage && avatarPlaceholder) {
        avatarImage.removeAttribute("src");
        avatarImage.style.display = "none";
        avatarPlaceholder.style.display = "flex";
    }

    socialContainer.innerHTML = "";

    const { data: links, error: linksError } = await supabase
        .from("profile_social_links")
        .select("platform_name, profile_url")
        .eq("profile_user_id", profile.user_id)
        .order("created_at", { ascending: true });

    if (linksError) {
        console.error("Public social links error:", linksError);
        return;
    }

    if (!links?.length) {
        const emptyMessage = document.createElement("p");
        emptyMessage.textContent = "No social links added yet.";
        socialContainer.appendChild(emptyMessage);
        return;
    }

    links.forEach(link => {
        const anchor = document.createElement("a");

        anchor.href = link.profile_url;
        anchor.target = "_blank";
        anchor.rel = "noopener";
        anchor.textContent = link.platform_name;

        socialContainer.appendChild(anchor);
    });
}

