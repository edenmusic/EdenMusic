async function updateEdenAppConfig(updates) {
    if (!updates || typeof updates !== "object") {
        return null;
    }

    const { data: current, error: readError } = await supabase
        .from("app_config")
        .select("id")
        .order("id", { ascending: false })
        .limit(1)
        .maybeSingle();

    if (readError || !current) {
        console.error(
            "EDEN APP CONFIG READ ERROR:",
            readError
        );
        return null;
    }

    const { data, error } = await supabase
        .from("app_config")
        .update(updates)
        .eq("id", current.id)
        .select()
        .single();

    if (error) {
        console.error(
            "EDEN APP CONFIG UPDATE ERROR:",
            error
        );
        return null;
    }

    window.EDEN_REMOTE_APP_CONFIG = data;

    console.log(
        "EDEN APP CONFIG UPDATED:",
        data
    );

    return data;
}

window.updateEdenAppConfig = updateEdenAppConfig;

async function getEdenCloudStorageUsage() {
    try {
        const buckets = [
            EDEN_APP_ASSETS.bucket,
            "song",
            "fun-vault-videos",
            "profiles-avatars"
        ];

        let fileCount = 0;
        let totalBytes = 0;

        for (const bucket of buckets) {
            const { data, error } = await supabase.storage
                .from(bucket)
                .list("", { limit: 1000, offset: 0 });

            if (error) {
                console.error("EDEN CLOUD STORAGE USAGE ERROR:", bucket, error);
                continue;
            }

            const files = (data || []).filter(item => item.id);
            fileCount += files.length;

            totalBytes += files.reduce(
                (total, file) => total + Number(file.metadata?.size || 0),
                0
            );
        }

        const usage = {
            buckets,
            fileCount,
            totalBytes,
            totalMB: totalBytes / (1024 * 1024),
            totalGB: totalBytes / (1024 * 1024 * 1024),
            targetGB: EDEN_APP_ASSETS.minimumCloudStorageGB
        };

        console.log("EDEN CLOUD STORAGE USAGE:", usage);
        return usage;
    } catch (error) {
        console.error("EDEN CLOUD STORAGE USAGE ERROR:", error);
        return null;
    }
}

