function updateEdenOnlineState() {
    const remoteOnlineOnly = window.EDEN_REMOTE_APP_CONFIG?.online_only !== false;
    const online = navigator.onLine;
    const appAvailable = online || !remoteOnlineOnly;

    const offlineGate = document.getElementById("eden-offline-gate");
    const app = document.querySelector(".app");

    if (offlineGate) {
        offlineGate.style.display = appAvailable ? "none" : "flex";
    }

    if (app) {
        app.style.display = appAvailable ? "" : "none";
    }

    document.body.classList.toggle(
        "eden-online",
        appAvailable
    );

    document.body.classList.toggle(
        "eden-offline",
        !appAvailable
    );

    window.edenIsOnline = online;
    window.edenOnlineOnly = remoteOnlineOnly;

    console.log(
        "EDEN ONLINE STATE:",
        appAvailable ? "ONLINE" : "OFFLINE"
    );
}

