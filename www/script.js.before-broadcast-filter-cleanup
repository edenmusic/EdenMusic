async function processExistingEdenLiveAnswer(roomId) {
    const answerRow = await getExistingEdenLiveAnswer(roomId);

    if (
        !answerRow ||
        !answerRow.payload ||
        !edenLivePeerConnection
    ) {
        console.log("EDEN LIVE: No existing answer found.");
        return false;
    }

    if (
        edenLivePeerConnection.signalingState !==
        "have-local-offer"
    ) {
        console.log(
            "EDEN LIVE: Peer is not waiting for an answer."
        );
        return false;
    }

    try {
        await edenLivePeerConnection.setRemoteDescription(
            new RTCSessionDescription(answerRow.payload)
        );

        console.log(
            "EDEN LIVE: Existing answer applied."
        );

        await processExistingEdenLiveIceCandidates(roomId);

        return true;
    } catch (error) {
        console.error(
            "EDEN LIVE EXISTING ANSWER ERROR:",
            error
        );

        return false;
    }
}

window.getExistingEdenLiveAnswer =
    getExistingEdenLiveAnswer;

window.processExistingEdenLiveAnswer =
    processExistingEdenLiveAnswer;

async function waitForEdenLiveAnswer(roomId, attempts = 10) {
    for (let i = 0; i < attempts; i++) {
        const applied = await processExistingEdenLiveAnswer(roomId);

        if (applied) {
            console.log("EDEN LIVE: Answer received by polling.");
            return true;
        }

        await new Promise(resolve => setTimeout(resolve, 1000));
    }

    console.log("EDEN LIVE: Answer polling timed out.");
    return false;
}

window.waitForEdenLiveAnswer = waitForEdenLiveAnswer;

function startEdenLiveAnswerWatcher(roomId) {
    if (window.edenLiveAnswerWatcher) {
        clearInterval(window.edenLiveAnswerWatcher);
    }

    window.edenLiveAnswerWatcher = setInterval(async () => {
        if (
            edenLivePeerConnection &&
            edenLivePeerConnection.signalingState === "have-local-offer"
        ) {
            await processExistingEdenLiveAnswer(roomId);
        }
    }, 1000);

    console.log("EDEN LIVE: Answer watcher started.");
}

window.startEdenLiveAnswerWatcher = startEdenLiveAnswerWatcher;

async function processExistingEdenLiveIceCandidates(roomId) {
    if (!edenLivePeerConnection) {
        return;
    }

    if (!edenLivePeerConnection.remoteDescription) {
        console.log("EDEN LIVE: Remote description not ready for ICE.");
        return;
    }

    const { data, error } = await supabase
        .from("live_signaling")
        .select("payload")
        .eq("room_id", roomId)
        .eq("message_type", "ice-candidate")
        .order("created_at", { ascending: true });

    if (error) {
        console.error(
            "EDEN LIVE EXISTING ICE LOOKUP ERROR:",
            error
        );
        return;
    }

data = (data || []).filter(event => {
    if (!event.broadcast_live) return true;
    const eventTime = new Date(event.event_date).getTime();
    const now = Date.now();
    return eventTime > now && eventTime - now <= 24 * 60 * 60 * 1000;
});

    if (!data?.length) {
        console.log("EDEN LIVE: No existing ICE candidates found.");
        return;
    }

    for (const row of data) {
        if (!row?.payload) {
            continue;
        }

        try {
            await edenLivePeerConnection.addIceCandidate(
                new RTCIceCandidate(row.payload)
            );

            console.log(
                "EDEN LIVE: Existing ICE candidate added."
            );
        } catch (error) {
            console.warn(
                "EDEN LIVE EXISTING ICE CANDIDATE SKIPPED:",
                error
            );
        }
    }
}

