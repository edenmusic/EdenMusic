function searchSongs() {
    const searchInput = document.getElementById("song-search");
    const songs = document.querySelectorAll(".song-row");

    if (!searchInput) return;

    const searchTerm = searchInput.value.toLowerCase().trim();

    let visibleSongs = 0;

    songs.forEach(song => {
        const title = song.dataset.title.toLowerCase();

        if (title.includes(searchTerm)) {
            song.style.display = "flex";
            visibleSongs++;
        } else {
            song.style.display = "none";
        }
    });

    const count = document.getElementById("song-count");

    if (count) {
        count.textContent =
            `${visibleSongs} song${visibleSongs === 1 ? "" : "s"}`;
    }
}
function closeSongPlayer() {
    const player = document.getElementById("song-player");

    if (player) {
        player.classList.remove("active");
    }

    document.body.classList.remove("player-open");
}


function previousSong() {
    if (!loadedTracks.length) return;

    const currentIndex = loadedTracks.findIndex(track => track.id === activelyPlayingTrackId);
    if (currentIndex === -1) return;

    const previousIndex = (currentIndex - 1 + loadedTracks.length) % loadedTracks.length;
    playSong(loadedTracks[previousIndex].id);
}

function nextSong() {
    if (!loadedTracks.length) return;

    const currentIndex = loadedTracks.findIndex(track => track.id === activelyPlayingTrackId);
    if (currentIndex === -1) return;

    const nextIndex = (currentIndex + 1) % loadedTracks.length;
    playSong(loadedTracks[nextIndex].id);
}

function togglePlayer() {
    const audio = document.getElementById("audio-player");
    const video = document.getElementById("player-video");

    const activeMedia = video && video.src ? video : audio;

    if (!activeMedia) return;

    if (activeMedia.paused) {
        activeMedia.play().catch(error => {
            console.error("Media playback error:", error);
        });
    } else {
        activeMedia.pause();
    }
}

