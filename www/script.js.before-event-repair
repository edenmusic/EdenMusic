async function loadFanVaultUpcomingEvents() {
    const container = document.getElementById("fan-vault-dashboard-events");
    if (!container) return;

    const { data, error } = await supabase
        .from("live_events")
        .select("id, title, description, thumbnail_url, scheduled_at, broadcast_live, is_live")
        .eq("is_live", false)
        .gte("scheduled_at", new Date().toISOString())
        .order("scheduled_at", { ascending: true });

    if (error) {
        console.error("EDEN UPCOMING EVENTS ERROR:", error);
        container.innerHTML =
            '<p class="dashboard-empty">Unable to load scheduled events.</p>';
        return;
    }

    if (!data || data.length === 0) {
        container.innerHTML =
            '<p class="dashboard-empty">No upcoming live events.</p>';
        return;
    }

    container.innerHTML = data.map(function(event) {
        const date = new Date(event.scheduled_at);
        const title = String(event.title || "Eden Live Event");
        const description = String(event.description || "Eden Music Live");

        return '<article class="dashboard-card">' +
            '<h3>' + escapeHtml(title) + '</h3>' +
            '<p>' + escapeHtml(description) + '</p>' +
            '<p>' + date.toLocaleString([], { dateStyle: "medium", timeStyle: "short" }) + '</p>' +
            '<div class="fan-vault-event-actions">' +
            '<button type="button" class="secondary-btn" onclick="editFanVaultEvent(' + JSON.stringify(event.id) + ')">✏️ Edit</button>' +
            '<button type="button" class="secondary-btn" onclick="deleteFanVaultEvent(' + JSON.stringify(event.id) + ')">🗑️ Delete</button>' +
            '</div>' +
            '</article>';
    }).join("");
}

window.loadFanVaultUpcomingEvents = loadFanVaultUpcomingEvents;


async function createFanVaultEvent() {
    const title =
        document.getElementById("fan-vault-event-title")?.value.trim();

    const description =
        document.getElementById("fan-vault-event-description")?.value.trim();

    const scheduledAt =
        document.getElementById("fan-vault-event-scheduled-at")?.value;

    const broadcastLive =
        document.getElementById("fan-vault-event-broadcast-live")?.checked === true;

    const message =
        document.getElementById("fan-vault-event-save-message");

    if (!title || !scheduledAt) {
        if (message) {
            message.textContent =
                "Please enter an event title and date/time.";
        }
        return;
    }

    const scheduledDate = new Date(scheduledAt);

    if (Number.isNaN(scheduledDate.getTime())) {
        if (message) {
            message.textContent =
                "Please enter a valid event date and time.";
        }
        return;
    }

    const { error } = await supabase
        .from("live_events")
        .insert({
            title: title,
            description: description || null,
            scheduled_at: scheduledDate.toISOString(),
            broadcast_live: broadcastLive,
            is_live: false
        });

    if (error) {
        console.error("EDEN UPCOMING EVENT CREATE ERROR:", error);

        if (message) {
            message.textContent =
                "Could not schedule upcoming event.";
        }
        return;
    }

    if (message) {
        message.textContent =
            "Upcoming event scheduled successfully.";
    }

    const titleInput =
        document.getElementById("fan-vault-event-title");

    const descriptionInput =
        document.getElementById("fan-vault-event-description");

    const scheduledInput =
        document.getElementById("fan-vault-event-scheduled-at");

    const broadcastInput =
        document.getElementById("fan-vault-event-broadcast-live");

    if (titleInput) titleInput.value = "";
    if (descriptionInput) descriptionInput.value = "";
    if (scheduledInput) scheduledInput.value = "";
    if (broadcastInput) broadcastInput.checked = true;

    await loadFanVaultUpcomingEvents();

    if (typeof loadHomeUpcomingShows === "function") {
        await loadHomeUpcomingShows();
    }
}

window.createFanVaultEvent = createFanVaultEvent;

document.addEventListener("DOMContentLoaded", function() {
    if (typeof loadFanVaultUpcomingEvents === "function") {
        loadFanVaultUpcomingEvents();
    }
});

async function editFanVaultEvent(eventId) {
    if (!eventId) return;

    const { data: event, error } = await supabase
        .from("live_events")
        .select("id, title, description, scheduled_at, broadcast_live")
        .eq("id", eventId)
        .maybeSingle();

    if (error || !event) {
        console.error("EDEN EVENT EDIT LOAD ERROR:", error);
        const message = document.getElementById("fan-vault-event-save-message");
        if (message) message.textContent = "Could not load event for editing.";
        return;
    }

    const titleInput = document.getElementById("fan-vault-event-title");
    const descriptionInput = document.getElementById("fan-vault-event-description");
    const scheduledInput = document.getElementById("fan-vault-event-scheduled-at");
    const broadcastInput = document.getElementById("fan-vault-event-broadcast-live");
    const controls = document.getElementById("fan-vault-event-controls");
    const message = document.getElementById("fan-vault-event-save-message");

    if (titleInput) titleInput.value = event.title || "";
    if (descriptionInput) descriptionInput.value = event.description || "";

    if (scheduledInput && event.scheduled_at) {
        const date = new Date(event.scheduled_at);
        const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
        scheduledInput.value = local.toISOString().slice(0, 16);
    }

    if (broadcastInput) {
        broadcastInput.checked = event.broadcast_live === true;
    }

    if (controls) {
        controls.dataset.editingEventId = event.id;
        controls.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });
    }

    if (message) {
        message.textContent = "Editing event. Update the details and save.";
    }
}

async function deleteFanVaultEvent(eventId) {
    if (!eventId) return;

    const confirmed = window.confirm("Delete this upcoming live event?");
    if (!confirmed) return;

    const { error } = await supabase
        .from("live_events")
        .delete()
        .eq("id", eventId);

    if (error) {
        console.error("EDEN EVENT DELETE ERROR:", error);
        const message = document.getElementById("fan-vault-event-save-message");
        if (message) message.textContent = "Could not delete event.";
        return;
    }

    const message = document.getElementById("fan-vault-event-save-message");
    if (message) message.textContent = "Upcoming event deleted successfully.";

    await loadFanVaultUpcomingEvents();

    if (typeof loadHomeUpcomingShows === "function") {
        await loadHomeUpcomingShows();
    }
}

window.editFanVaultEvent = editFanVaultEvent;
window.deleteFanVaultEvent = deleteFanVaultEvent;
