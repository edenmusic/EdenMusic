* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --bg: #08060b;
    --surface: #111016;
    --surface-2: #18151e;
    --border: rgba(255,255,255,0.08);
    --text: #ffffff;
    --muted: #aaa4b2;
    --accent: #b45cff;
    --accent-2: #7c3aed;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
}

button {
    font: inherit;
    cursor: pointer;
    border: none;
}

.app {
    width: 100%;
    max-width: 900px;
    margin: auto;
    padding: 20px 18px 100px;
}

/* HEADER */

.top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
}

.top-bar h1 {
    font-size: 28px;
    letter-spacing: -0.5px;
}

.top-bar p {
    color: var(--muted);
    margin-top: 5px;
    font-size: 14px;
}

.notification-btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    color: white;
    border: 1px solid var(--border);
    font-size: 19px;
}

/* GENERAL */

.eyebrow {
    color: var(--accent);
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1.5px;
}

.section {
    margin-top: 30px;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    margin-bottom: 14px;
}

.section-heading h2 {
    margin-top: 5px;
    font-size: 22px;
}

.text-btn {
    background: none;
    color: var(--accent);
    font-size: 13px;
}

.small-label {
    color: var(--muted);
    font-size: 11px;
}

/* WELCOME */

.welcome-card {
    padding: 24px;
    border-radius: 24px;
    background:
        radial-gradient(circle at top right, rgba(180,92,255,.25), transparent 45%),
        linear-gradient(135deg, #17121f, #0e0c12);
    border: 1px solid var(--border);
}

.welcome-text h2 {
    font-size: 30px;
    margin: 8px 0;
}

.welcome-text p {
    color: var(--muted);
    line-height: 1.6;
    max-width: 600px;
}

.account-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    flex-wrap: wrap;
}

.primary-btn,
.secondary-btn {
    padding: 12px 17px;
    border-radius: 12px;
    font-weight: bold;
}

.primary-btn {
    background: var(--accent);
    color: #fff;
}

.secondary-btn {
    background: rgba(255,255,255,.06);
    color: white;
    border: 1px solid var(--border);
}

/* MUSIC */

.featured-song {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
}

.song-art {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    border-radius: 14px;
    display: grid;
    place-items: center;
    font-size: 27px;
    background: linear-gradient(135deg, #6d28d9, #b45cff);
}

.song-info {
    flex: 1;
}

.song-info span {
    color: var(--accent);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.song-info h3 {
    margin-top: 4px;
}

.song-info p {
    color: var(--muted);
    font-size: 13px;
    margin-top: 3px;
}

.play-btn {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background: white;
    color: #111;
    font-size: 16px;
}

/* REELS */

.reels-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

.reel-card {
    min-height: 300px;
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border);
    background-size: cover;
    background-position: center;
}

.reel-one {
    background: linear-gradient(160deg, #251535, #09070b);
}

.reel-two {
    background: linear-gradient(160deg, #321e2b, #0b080c);
}

.reel-three {
    background: linear-gradient(160deg, #182538, #08090c);
}

.reel-overlay {
    position: absolute;
    inset: 0;
    padding: 16px;
    display: flex;
    flex-direction: column;
    justify-content: end;
    background: linear-gradient(transparent 25%, rgba(0,0,0,.9));
}

.reel-overlay span {
    color: #ddd;
    font-size: 10px;
    letter-spacing: 1px;
}

.reel-overlay h3 {
    margin: 6px 0 12px;
}

.reel-overlay button {
    width: fit-content;
    padding: 8px 12px;
    border-radius: 9px;
    background: white;
    color: #111;
    font-size: 12px;
    font-weight: bold;
}

/* VAULT */

.vault-card {
    margin-top: 30px;
    padding: 22px;
    border-radius: 22px;
    background: linear-gradient(135deg, #18121f, #100d15);
    border: 1px solid rgba(180,92,255,.25);
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
}

.vault-icon {
    width: 52px;
    height: 52px;
    border-radius: 15px;
    display: grid;
    place-items: center;
    background: rgba(180,92,255,.12);
    font-size: 23px;
}

.vault-card h2 {
    margin: 5px 0;
}

.vault-card p {
    color: var(--muted);
    line-height: 1.5;
    font-size: 13px;
}

/* CONCERTS */

.concert-card {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
}

.concert-date {
    width: 60px;
    height: 65px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: #1b1424;
    text-align: center;
}

.concert-date strong {
    font-size: 22px;
}

.concert-date span {
    font-size: 9px;
    color: var(--muted);
}

.concert-info {
    flex: 1;
}

.concert-info span {
    color: var(--accent);
    font-size: 11px;
}

.concert-info h3 {
    margin: 4px 0;
}

.concert-info p {
    color: var(--muted);
    font-size: 13px;
}

.concert-status {
    color: var(--muted);
    font-size: 11px;
}

/* UPDATES */

.update-card {
    margin-top: 30px;
    padding: 18px;
    display: flex;
    gap: 14px;
    align-items: center;
    border: 1px solid var(--border);
    background: var(--surface);
    border-radius: 18px;
}

.update-icon {
    font-size: 25px;
}

.update-card h3 {
    margin: 4px 0;
}

.update-card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
}

/* BOTTOM NAV */

.bottom-nav {
    position: fixed;
    left: 50%;
    bottom: 15px;
    transform: translateX(-50%);
    width: min(92%, 600px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding: 8px;
    background: rgba(18,16,22,.94);
    backdrop-filter: blur(15px);
    border: 1px solid var(--border);
    border-radius: 20px;
    z-index: 900;
}

.nav-item {
    background: none;
    color: var(--muted);
    padding: 8px 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
}

.nav-item span {
    font-size: 18px;
}

.nav-item small {
    font-size: 10px;
}

.nav-item.active {
    color: var(--accent);
}

/* MESSAGE */

.message-box {
    position: fixed;
    left: 50%;
    bottom: 90px;
    transform: translateX(-50%) translateY(20px);
    padding: 12px 17px;
    border-radius: 12px;
    background: #24202b;
    border: 1px solid var(--border);
    color: white;
    font-size: 13px;
    opacity: 0;
    pointer-events: none;
    transition: .25s ease;
    z-index: 100;
    text-align: center;
    max-width: 90%;
}

.message-box.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}

/* RESPONSIVE */

@media (max-width: 650px) {

    .app {
        padding: 16px 14px 100px;
    }

    .welcome-text h2 {
        font-size: 26px;
    }

    .reels-container {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding-bottom: 5px;
    }

    .reel-card {
        min-width: 230px;
        height: 330px;
        scroll-snap-align: start;
    }

    .vault-card {
        grid-template-columns: auto 1fr;
    }

    .vault-card .primary-btn {
        grid-column: 1 / -1;
        width: 100%;
    }

    .concert-status {
        display: none;
    }
}

/* ================= MUSIC SCREEN ================= */

.music-screen {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 80;
    overflow-y: auto;
    background: var(--bg);
    padding: 24px 18px 110px;
}

.music-screen.active {
    display: block;
}

.music-screen-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto 24px;
}

.music-screen-header h2 {
    font-size: 32px;
    margin-top: 6px;
}

.music-screen-header p {
    color: var(--muted);
    margin-top: 5px;
}

.close-music {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--surface);
    color: white;
    border: 1px solid var(--border);
    font-size: 18px;
}

.music-search {
    max-width: 900px;
    margin: 0 auto 25px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
}

.music-search span {
    font-size: 17px;
}

.music-search input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    color: white;
    font-size: 15px;
}

.music-search input::placeholder {
    color: var(--muted);
}

.music-section-title {
    max-width: 900px;
    margin: 0 auto 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.music-section-title h3 {
    font-size: 20px;
}

.music-section-title span {
    color: var(--muted);
    font-size: 12px;
}

#song-list {
    max-width: 900px;
    margin: auto;
}

.song-row {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 13px;
    margin-bottom: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 17px;
}

.song-number {
    width: 25px;
    color: var(--muted);
    font-size: 11px;
    text-align: center;
}

.song-cover {
    width: 55px;
    height: 55px;
    flex-shrink: 0;
    position: relative;
    overflow: hidden;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, #6d28d9, #b45cff);
    font-size: 22px;
}

.song-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.song-details {
    flex: 1;
    min-width: 0;
}

.song-details p {
    color: var(--muted);
    font-size: 12px;
}

.song-duration {
    color: var(--muted);
    font-size: 11px;
}

.song-play {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: white;
    color: #111;
    font-size: 13px;
}

@media (max-width: 500px) {
    .song-number {
        display: none;
    }

    .song-duration {
        display: none;
    }

    .music-screen {
        padding-left: 14px;
        padding-right: 14px;
    }
}




/* ================= FULL SCREEN SONG PLAYER ================= */

.song-player {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    background: #111;
    color: white;
    display: none;
    flex-direction: column;
    box-sizing: border-box;
    padding: 24px;
    overflow-y: auto;
}

.song-player.active {
    display: flex;
}

.player-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 30px;
}

.player-header span {
    font-size: 12px;
    letter-spacing: 2px;
    opacity: 0.7;
}

.player-header button {
    border: none;
    background: transparent;
    color: white;
    font-size: 22px;
    cursor: pointer;
}

.player-artwork {
    width: min(80vw, 360px);
    aspect-ratio: 1;
    margin: 0 auto 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 20px;
    background: #222;
    font-size: 90px;
}

.player-info {
    margin-bottom: 25px;
}

.player-info h2 {
    margin: 0 0 6px;
    font-size: 28px;
}

.player-info p {
    margin: 0;
    opacity: 0.7;
}

.player-progress input {
    width: 100%;
}

.player-times {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    opacity: 0.7;
    margin-top: 6px;
}

.player-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 35px;
    margin: 30px 0;
}

.player-controls button {
    border: none;
    background: transparent;
    color: white;
    font-size: 28px;
    cursor: pointer;
}

.player-controls .main-play-button {
    width: 65px;
    height: 65px;
    border-radius: 50%;
    background: white;
    color: #111;
    font-size: 25px;
}

.player-lyrics {
    margin-top: 10px;
    padding: 20px;
    border-radius: 16px;
    background: #1c1c1c;
}

.player-lyrics h3 {
    margin-top: 0;
}

.player-lyrics p {
    line-height: 1.7;
    opacity: 0.8;
}


.player-artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    display: block;
}

.player-video-container {
    width: min(90vw, 720px);
    margin: 0 auto 30px;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
}

.player-video-container video {
    width: 100%;
    max-height: 55vh;
    display: block;
    object-fit: contain;
}


/* ================= ARTIST DASHBOARD ================= */

.artist-dashboard {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow-y: auto;
    padding: 24px 20px 110px;
    background: #0b0b0f;
}

.dashboard-header {
    margin-bottom: 18px;
}

.dashboard-header h2 {
    margin: 5px 0;
}

.dashboard-header p {
    color: var(--muted);
    margin: 0;
}

.dashboard-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.dashboard-card label {
    margin-top: 8px;
    font-size: 13px;
    font-weight: 600;
}

.dashboard-card input,
.dashboard-card textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 13px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.25);
    color: white;
    font: inherit;
}

.dashboard-card textarea {
    resize: vertical;
    min-height: 140px;
}

.dashboard-card input[type="file"] {
    padding: 10px;
}

#save-song-button {
    margin-top: 15px;
}


/* Developer dashboard is hidden until authentication succeeds */
#developer-dashboard-header,
#developer-controls {
    display: none;
}

/* ================= DEVELOPER RELEASE LIBRARY ================= */

.developer-release-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 10px;
}

.developer-release-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.developer-release-card img {
    width: 64px;
    height: 64px;
    min-width: 64px;
    object-fit: cover;
    border-radius: 12px;
    display: block;
}

.developer-release-info {
    min-width: 0;
}

.developer-release-info h4 {
    margin: 0 0 4px;
    font-size: 16px;
}

.developer-release-info p {
    margin: 0;
    color: var(--muted);
    font-size: 13px;
}

.dashboard-empty {
    color: var(--muted);
    margin: 0;
}



/* ================= PUBLIC PROFILE SCREEN ================= */

.profile-screen {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow-y: auto;
    padding: 24px 20px 110px;
    background: #0b0b0f;
}

.profile-screen.active {
    display: block;
}

.profile-header-card {
    text-align: center;
    padding: 28px 20px;
    margin-bottom: 24px;
}

.profile-avatar {
    width: 90px;
    height: 90px;
    margin: 0 auto 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-size: 42px;
    background: rgba(255, 255, 255, 0.08);
}

.profile-header-card h2 {
    margin: 0 0 8px;
}

.profile-header-card p {
    margin: 0;
    opacity: 0.7;
}

.profile-section {
    margin-top: 20px;
}

.profile-section h3 {
    margin: 8px 0 18px;
}

.social-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.social-stack a {
    display: block;
    padding: 14px 16px;
    border-radius: 12px;
    text-decoration: none;
    text-align: center;
}

/* ================= PROFILE CUSTOMIZATION ================= */

.profile-editor-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 12px 0;
}

.profile-editor-avatar .profile-avatar-image,
.profile-editor-avatar .profile-avatar {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
}

.profile-editor-avatar .profile-avatar-image {
    display: none;
}

.profile-editor-avatar .profile-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
}

.profile-avatar-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
}

.profile-avatar-image {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
}

#public-profile-avatar {
    display: none;
}

#public-profile-avatar-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
}

#profile-avatar-file {
    display: block;
    width: 100%;
    margin: 10px 0 18px;
}

#social-links-editor {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 12px 0;
}

.social-link-editor-row {
    display: grid;
    grid-template-columns: 1fr 1.5fr auto;
    gap: 8px;
    align-items: center;
}

.social-link-editor-row input {
    min-width: 0;
}

.remove-social-link-button {
    white-space: nowrap;
}

#add-social-link-button {
    margin-bottom: 16px;
}

#public-social-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

#public-social-links a {
    text-decoration: none;
}

@media (max-width: 600px) {
    .social-link-editor-row {
        grid-template-columns: 1fr;
    }

    .remove-social-link-button {
        width: 100%;
    }
}


.dashboard-vault-video {
    width: 100%;
    max-width: 420px;
    display: block;
    border-radius: 14px;
    margin-bottom: 14px;
}


.public-reel-video {
    width: 100%;
    height: 100%;
    min-height: 300px;
    display: block;
    object-fit: cover;
    position: relative;
    z-index: 1;
}

.public-reel-video + .reel-overlay {
    pointer-events: none;
}


/* ================= PUBLIC FUN VAULT REELS ================= */

#public-reels-container {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

#public-reels-container .reel-card {
    min-height: 430px;
    aspect-ratio: 9 / 16;
    background: #080808;
    overflow: hidden;
}

#public-reels-container .public-reel-video {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    background: #000;
}

#public-reels-container .reel-overlay {
    z-index: 2;
    pointer-events: none;
    padding: 18px;
}

#public-reels-container .reel-overlay h3 {
    font-size: 18px;
    margin: 6px 0;
}

#public-reels-container .reel-overlay p {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
}

@media (max-width: 700px) {
    #public-reels-container {
        display: flex;
        overflow-x: auto;
        gap: 12px;
        scroll-snap-type: x mandatory;
        padding-bottom: 8px;
    }

    #public-reels-container .reel-card {
        flex: 0 0 230px;
        min-height: 410px;
        scroll-snap-align: start;
    }
}


/* ================= FAN VAULT BEHIND-THE-SCENES REELS ================= */

/* ================= FAN VAULT TIKTOK REEL LAYOUT ================= */
#fan-vault-screen .reels-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    width: 100%;
    height: calc(100vh - 120px);
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-y: contain;
}

#fan-vault-screen .reel-card {
    width: min(100%, 430px);
    height: calc(100vh - 120px);
    min-height: 0;
    flex: 0 0 calc(100vh - 120px);
    background: #080808;
    overflow: hidden;
    position: relative;
    border-radius: 16px;
    scroll-snap-align: start;
}

#fan-vault-screen .reel-video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    background: #000;
}

#fan-vault-screen .reel-info {
    position: absolute;
    left: 0;
    right: 70px;
    bottom: 0;
    z-index: 2;
    padding: 22px 16px;
    background: linear-gradient(transparent, rgba(0,0,0,.9));
    pointer-events: none;
}

#fan-vault-screen .reel-info h3 {
    margin: 0 0 6px;
    font-size: 18px;
}

#fan-vault-screen .reel-info p {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
}

#fan-vault-screen .reel-engagement {
    position: absolute;
    right: 10px;
    bottom: 24px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
}

#fan-vault-screen .reel-engagement button {
    width: 48px;
    min-height: 48px;
    padding: 5px;
    border: 0;
    border-radius: 50%;
    background: rgba(0,0,0,.55);
    color: #fff;
    font-size: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    cursor: pointer;
}

#fan-vault-screen .reel-engagement button:first-child {
    font-size: 18px;
}

#fan-vault-screen .reel-engagement button:hover {
    background: rgba(255,255,255,.18);
}

@media (max-width: 700px) {
#fan-vault-screen .reels-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    width: 100%;
    height: calc(100vh - 120px);
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-y: contain;
}

/* FAN VAULT TOP BACK BUTTON */
#fan-vault-screen .fan-vault-top-back {
    position: sticky;
    top: 12px;
    z-index: 100;
    margin-bottom: 18px;
}

/* ================= FAN VAULT ENGAGEMENT CLICK FIX ================= */

#fan-vault-screen .reel-engagement {
    position: absolute;
    right: 10px;
    bottom: 24px;
    z-index: 20;
    pointer-events: auto;
}

#fan-vault-screen .reel-engagement button {
    position: relative;
    z-index: 21;
    pointer-events: auto;
    touch-action: manipulation;
}

#fan-vault-screen .reel-video {
    position: relative;
    z-index: 1;
}


/* ================= FAN VAULT COMMENTS PANEL ================= */

#fan-vault-comments-panel {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
}

#fan-vault-comments-panel.active {
    display: block;
}

.fan-vault-comments-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.65);
}

.fan-vault-comments-sheet {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(100%, 430px);
    max-height: 70vh;
    background: #111;
    color: #fff;
    border-radius: 20px 20px 0 0;
    overflow-y: auto;
    padding-bottom: 20px;
}

.fan-vault-comments-header {
    position: sticky;
    top: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px;
    background: #111;
    border-bottom: 1px solid rgba(255,255,255,.1);
}

.fan-vault-comments-header button {
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 20px;
    cursor: pointer;
}

.fan-vault-comment-item {
    padding: 14px 16px;
    border-bottom: 1px solid rgba(255,255,255,.08);
}

.fan-vault-comment-item p {
    margin: 0;
    line-height: 1.4;
}

.fan-vault-no-comments {
    padding: 30px 16px;
    text-align: center;
    opacity: .7;
}
