<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Eden Music</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="app">

    <!-- ================= HEADER ================= -->
    <header class="top-bar">
        <div>
            <h1>Eden Music</h1>
            <p>Welcome to the inner circle.</p>
        </div>

        <button class="notification-btn" onclick="showMessage('Notifications coming soon.')">
            🔔
        </button>
    </header>


    <!-- ================= ACCOUNT / GUEST ================= -->
    <section class="welcome-card">

        <div class="welcome-text">
            <span class="eyebrow">WELCOME</span>
            <h2>Follow the journey.</h2>
            <p>
                Create an account to unlock the Fan Vault,
                follow Eden's journey and stay connected.
            </p>
        </div>

        <div class="account-actions">
            <button class="primary-btn" onclick="showMessage('Account creation will be connected in the next stage.')">
                Create Account
            </button>

            <button class="secondary-btn" onclick="showMessage('Guest mode activated.')">
                Continue as Guest
            </button>
        </div>

    </section>


    <!-- ================= FEATURED MUSIC ================= -->
    <section class="section">

        <div class="section-heading">
            <div>
                <span class="eyebrow">MUSIC</span>
                <h2>Featured</h2>
            </div>

            <button class="text-btn" onclick="showMessage('Music section coming next.')">
                See all
            </button>
        </div>

        <div class="featured-song">

            <div class="song-art">
                🎵
            </div>

            <div class="song-info">
                <span>Latest Release</span>
                <h3>Eden Music</h3>
                <p>Play the latest song</p>
            </div>

            <button
                class="play-btn"
                onclick="showMessage('The full music player will be added in Stage 2.')">
                ▶
            </button>

        </div>

    </section>


    <!-- ================= REELS ================= -->
<section class="section">

    <div class="section-heading">
        <div>
            <span class="eyebrow">BEHIND THE SCENES</span>
            <h2>Reels</h2>
        </div>

        <span class="small-label">Guest: 5 videos</span>
    </div>

    <div id="public-reels-container" class="reels-container">
        <p class="dashboard-empty">Loading reels...</p>
    </div>

</section>


<!-- ================= FAN VAULT PREVIEW ================= -->
    <section class="vault-card">

        <div class="vault-icon">🔐</div>

        <div>
            <span class="eyebrow">EXCLUSIVE</span>
            <h2>Fan Vault</h2>
            <p>
                Behind-the-scenes videos, exclusive updates,
                live moments, merchandise and more.
            </p>
        </div>

        <button
            class="primary-btn"
            onclick="showMessage('Create an account to enter the Fan Vault.')">
            Enter Vault
        </button>

    </section>


    <!-- ================= UPCOMING SHOWS ================= -->
    <section class="section">

        <div class="section-heading">
            <div>
                <span class="eyebrow">LIVE</span>
                <h2>Upcoming Shows</h2>
            </div>

            <button
                class="text-btn"
                onclick="showMessage('Concert dates will be connected to the Fan Vault.')">
                View all
            </button>
        </div>

        <div class="concert-card">

            <div class="concert-date">
                <strong>--</strong>
                <span>DATE</span>
            </div>

            <div class="concert-info">
                <span>Upcoming Event</span>
                <h3>Concert information</h3>
                <p>Venue • Time</p>
            </div>

            <div class="concert-status">
                Coming soon
            </div>

        </div>

    </section>


    <!-- ================= NOTIFICATIONS ================= -->
    <section class="update-card">

        <div class="update-icon">✨</div>

        <div>
            <span class="eyebrow">EDEN UPDATES</span>
            <h3>Stay connected</h3>
            <p>
                New music, live events, releases and exclusive
                updates will appear here.
            </p>
        </div>

    </section>

<!-- ================= ARTIST DASHBOARD ================= -->
<section id="artist-dashboard" class="artist-dashboard">

    <button class="secondary-btn" onclick="closeDeveloperDashboard()">← Back to Profile</button>

    <div id="developer-login" class="dashboard-card">
        <span class="eyebrow">DEVELOPER ACCESS</span>
        <h3>Artist Dashboard</h3>
        <p>Sign in to manage Eden Music releases.</p>

        <label for="developer-email">Email</label>
        <input id="developer-email" type="email" placeholder="Developer email" autocomplete="email">

        <label for="developer-password">Password</label>
        <input id="developer-password" type="password" placeholder="Password" autocomplete="current-password">

        <button id="developer-login-button" class="primary-btn" onclick="developerLogin()">
            Developer Login
        </button>

        <p id="developer-login-message"></p>
    </div>

    <div id="developer-dashboard-header" class="dashboard-header">
        <div>
            <span class="eyebrow">DEVELOPER</span>
            <h2>Artist Dashboard</h2>
            <p>Manage Eden Music releases.</p>
        </div>
    </div>

    <div id="developer-controls" class="dashboard-card">

        <label for="song-title-input">Song Title</label>
        <input id="song-title-input" type="text" placeholder="Enter song title">

        <label for="song-artist-input">Artist</label>
        <input id="song-artist-input" type="text" placeholder="Eden" value="Eden">

        <label for="song-audio-input">Audio File</label>
        <input id="song-audio-input" type="file" accept="audio/*">

        <label for="song-cover-input">Cover Artwork</label>
        <input id="song-cover-input" type="file" accept="image/*">

        <label for="song-video-input">Music Video</label>
        <input id="song-video-input" type="file" accept="video/*">

        <label for="song-lyrics-input">Lyrics</label>
        <textarea id="song-lyrics-input" rows="8" placeholder="Enter lyrics here..."></textarea>

        <button id="save-song-button" class="primary-btn" onclick="saveSongToSupabase()">
            Save Song
        </button>

    </div>

    <div class="dashboard-header">
        <div>
            <span class="eyebrow">RELEASES</span>
            <h3>Your Music Library</h3>
            <p>Manage songs currently published in Eden Music.</p>
        </div>
    </div>

    <div id="developer-release-list" class="developer-release-list">
        <p class="dashboard-empty">Loading releases...</p>
    </div>

    <div class="dashboard-header">
        <div>
            <span class="eyebrow">FUN VAULT</span>
            <h3>Fun Vault Videos</h3>
            <p>Upload and manage exclusive videos for your fans.</p>
        </div>
    </div>

    <div id="fun-vault-controls" class="dashboard-card">

        <label for="fun-vault-title">Video Title</label>
        <input
            id="fun-vault-title"
            type="text"
            placeholder="Enter video title"
        >

        <label for="fun-vault-description">Description</label>
        <textarea
            id="fun-vault-description"
            rows="4"
            placeholder="Tell fans about this video..."
        ></textarea>

        <label for="fun-vault-video-input">Video File</label>
        <input
            id="fun-vault-video-input"
            type="file"
            accept="video/*"
        >

        <label class="checkbox-row">
            <input
                id="fun-vault-published"
                type="checkbox"
                checked
            >
            Publish immediately
        </label>

        <button
            id="save-fun-vault-button"
            class="primary-btn"
            onclick="saveFunVaultVideo()"
        >
            Upload Fun Vault Video
        </button>

        <p id="fun-vault-save-message"></p>
    </div>

    <div class="dashboard-header">
        <div>
            <span class="eyebrow">FUN VAULT LIBRARY</span>
            <h3>Your Exclusive Videos</h3>
            <p>Manage videos currently available in the Fun Vault.</p>
        </div>
    </div>

    <div id="fun-vault-list" class="developer-release-list">
        <p class="dashboard-empty">Loading Fun Vault videos...</p>
    </div>

    <div class="dashboard-header">
        <div>
            <span class="eyebrow">PROFILE</span>
            <h3>Artist Profile</h3>
            <p>Update the public Eden Music artist profile.</p>
        </div>
    </div>

    <div id="developer-profile-controls" class="dashboard-card">
        <label for="profile-display-name">Display Name</label>
        <input id="profile-display-name" type="text" placeholder="Eden">

        <label for="profile-bio">Bio</label>
        <textarea id="profile-bio" rows="6" placeholder="Tell listeners about Eden..."></textarea>

        <label>Profile Picture</label>

        <div class="profile-editor-avatar">
            <img
                id="developer-profile-avatar"
                class="profile-avatar-image"
                src=""
                alt="Profile picture"
            >

            <div
                id="developer-profile-avatar-placeholder"
                class="profile-avatar"
            >
                ✨
            </div>
        </div>

        <input
            id="profile-avatar-file"
            type="file"
            accept="image/*"
        >

        <h4>Social Links</h4>

        <div id="social-links-editor"></div>

        <button
            type="button"
            class="secondary-btn"
            id="add-social-link-button"
            onclick="addSocialLinkField()"
        >
            + Add Social Link
        </button>

        <button
            id="save-profile-button"
            class="primary-btn"
            onclick="saveDeveloperProfile()"
        >
            Save Profile
        </button>

        <p id="profile-save-message"></p>
    </div>

    <button id="developer-logout-button" class="secondary-btn" onclick="developerLogout()">Log Out</button>

    <div id="song-editor" class="dashboard-card" style="display:none;">
        <span class="eyebrow">SONG EDITOR</span>
        <h3 id="song-editor-title">Edit Song</h3>

        <label for="edit-song-title">Song Title</label>
        <input id="edit-song-title" type="text" placeholder="Song title">

        <label for="edit-song-artist">Artist</label>
        <input id="edit-song-artist" type="text" placeholder="Eden">

        <label for="edit-song-audio">Replace Audio File</label>
        <input id="edit-song-audio" type="file" accept="audio/*">

        <label for="edit-song-cover">Replace Cover Artwork</label>
        <input id="edit-song-cover" type="file" accept="image/*">

        <label for="edit-song-video">Replace Music Video</label>
        <input id="edit-song-video" type="file" accept="video/*">

        <label for="edit-song-lyrics">Lyrics</label>
        <textarea id="edit-song-lyrics" rows="12" placeholder="Enter lyrics here..."></textarea>

        <button id="save-song-edit-button" class="primary-btn" onclick="saveEditedSong()">
            Save Song Changes
        </button>

        <button class="secondary-btn" onclick="cancelSongEdit()">
            Cancel
        </button>

        <p id="song-editor-message"></p>
    </div>
    <div id="lyrics-editor" class="dashboard-card" style="display:none;">
        <span class="eyebrow">LYRICS EDITOR</span>
        <h3 id="lyrics-editor-title">Edit Lyrics</h3>
        <textarea id="lyrics-editor-input" rows="12" placeholder="Enter lyrics here..."></textarea>
        <button id="save-lyrics-button" class="primary-btn" onclick="saveEditedLyrics()">Save Lyrics</button>
        <button class="secondary-btn" onclick="cancelLyricsEdit()">Cancel</button>
        <p id="lyrics-editor-message"></p>
    </div>

</section>

<!-- ================= MUSIC SCREEN ================= -->
<section id="music-screen" class="music-screen">

    <div class="music-screen-header">
        <div>
            <span class="eyebrow">EDEN MUSIC</span>
            <h2>Music</h2>
            <p>Listen to the latest releases.</p>
        </div>

        <button class="close-music" onclick="closeMusicScreen()">✕</button>
    </div>

    <!-- SEARCH -->
    <div class="music-search">
        <span>🔎</span>
        <input
            type="search"
            id="song-search"
            placeholder="Search songs..."
            oninput="searchSongs()">
    </div>

    <!-- SONG LIST -->
    <div class="music-section-title">
        <h3>All Songs</h3>
        <span id="song-count">3 songs</span>
    </div>

    <div id="song-list">

        <article class="song-row" data-title="Midnight">
            <div class="song-number">01</div>

            <div class="song-cover">🎵</div>

            <div class="song-details">
                <h3>Midnight</h3>
                <p>Eden • R&B</p>
            </div>

            <span class="song-duration">3:42</span>

            <button
                class="song-play"
                onclick="playSong('Midnight')">
                ▶
            </button>
        </article>


        <article class="song-row" data-title="After Hours">
            <div class="song-number">02</div>

            <div class="song-cover">🎶</div>

            <div class="song-details">
                <h3>After Hours</h3>
                <p>Eden • Soul</p>
            </div>

            <span class="song-duration">3:18</span>

            <button
                class="song-play"
                onclick="playSong('After Hours')">
                ▶
            </button>
        </article>


        <article class="song-row" data-title="Unreleased">
            <div class="song-number">03</div>

            <div class="song-cover">✨</div>

            <div class="song-details">
                <h3>Unreleased</h3>
                <p>Eden • Coming soon</p>
            </div>

            <span class="song-duration">--:--</span>

            <button
                class="song-play"
                onclick="playSong('Unreleased')">
                ▶
            </button>
        </article>

    </div>

</section>
    <!-- ================= PUBLIC PROFILE SCREEN ================= -->
<section id="profile-screen" class="profile-screen">
    <div class="profile-header-card">

        <div class="profile-avatar-wrapper">
            <img
                id="public-profile-avatar"
                class="profile-avatar-image"
                src=""
                alt="Eden profile picture"
            >
            <div
                id="public-profile-avatar-placeholder"
                class="profile-avatar"
            >
                ✨
            </div>
        </div>

        <h2 id="public-profile-name">Eden</h2>
        <p id="public-profile-bio">R&amp;B Artist &amp; Producer</p>
    </div>

    <div class="profile-section">
        <span class="eyebrow">FOLLOW EDEN</span>
        <h3>Stay connected</h3>

        <div id="public-social-links" class="social-stack"></div>
    </div>

    <div class="profile-section developer-access-section">
        <span class="eyebrow">DEVELOPER</span>
        <h3>Artist Dashboard</h3>

        <button class="secondary-btn" onclick="openDeveloperDashboard()">
            Developer Access
        </button>
    </div>
</section>

<!-- ================= BOTTOM NAVIGATION ================= -->
    <nav class="bottom-nav">

        <button class="nav-item active" onclick="closeProfileScreen()">
            <span>⌂</span>
            <small>Home</small>
        </button>

        <button class="nav-item" onclick="openMusicScreen()">
            <span>♫</span>
            <small>Music</small>
        </button>

        <button class="nav-item" onclick="showMessage('Fan Vault will be built in Stage 3.')">
            <span>🔐</span>
            <small>Vault</small>
        </button>

        <button class="nav-item" onclick="openProfileScreen()">
            <span>●</span>
            <small>Profile</small>
        </button>

    </nav>

</div>


<!-- ================= MESSAGE ================= -->
<div id="message-box" class="message-box"></div>


<script>

function showMessage(message) {

    const box = document.getElementById("message-box");

    box.textContent = message;
    box.classList.add("show");

    setTimeout(() => {
        box.classList.remove("show");
    }, 3000);
}

</script>

<script type="module" src="script.js"></script>

<!-- ================= FULL SCREEN SONG PLAYER ================= -->
<section id="song-player" class="song-player">
    <audio id="audio-player" preload="metadata"></audio>

    <div class="player-header">
        <button class="player-back" onclick="closeSongPlayer()">✕</button>
        <span>NOW PLAYING</span>
        <button class="player-more">•••</button>
    </div>

    <div class="player-artwork">
        <div id="player-cover">🎵</div>
    </div>

    <div id="player-video-container" class="player-video-container" style="display:none;">
        <video id="player-video" controls playsinline preload="metadata"></video>
    </div>

    <div class="player-info">
        <h2 id="player-title">Midnight</h2>
        <p id="player-artist">Eden</p>
    </div>

    <div class="player-progress">
        <input type="range" id="player-progress" min="0" max="100" value="0">
        <div class="player-times">
            <span id="player-current-time">0:00</span>
            <span id="player-duration">3:42</span>
        </div>
    </div>

    <div class="player-controls">
        <button onclick="previousSong()">⏮</button>
        <button id="main-play-button" class="main-play-button" onclick="togglePlayer()">▶</button>
        <button onclick="nextSong()">⏭</button>
    </div>

    <div class="player-lyrics">
        <h3>Lyrics</h3>
        <p id="player-lyrics-text">Lyrics will appear here.</p>
    </div>

</section>
</body>
</html>
