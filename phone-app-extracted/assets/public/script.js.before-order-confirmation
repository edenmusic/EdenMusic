async function deleteSong(songId) {
    const confirmed = confirm(
        "Are you sure you want to delete this song?"
    );

    if (!confirmed) {
        return;
    }

    const { data: song, error: songError } = await supabase
        .from("song")
        .select("id, title")
        .eq("id", songId)
        .single();

    if (songError) {
        console.error("Load song for deletion error:", songError);
        alert("Could not find the song.");
        return;
    }

    const { error: deleteError } = await supabase
        .from("song")
        .delete()
        .eq("id", songId);

    if (deleteError) {
        console.error("Delete song error:", deleteError);
        alert("Could not delete the song.");
        return;
    }

    alert(`"${song.title}" was deleted successfully.`);

    await loadDeveloperReleases();
    await loadSongsFromSupabase();
}

window.deleteSong = deleteSong;


async function loadFunVaultVideos() {
    const list = document.getElementById("fun-vault-list");

    if (!list) return;

    const { data: videos, error } = await supabase
        .from("fun_vault_videos")
        .select("id, title, description, video_url, thumbnail_url, created_at, is_published")
        .order("created_at", { ascending: false });

    if (error) {
        console.error("Load Fun Vault videos error:", error);
        list.innerHTML = '<p class="dashboard-empty">Could not load Fun Vault videos.</p>';
        return;
    }

    if (!videos?.length) {
        list.innerHTML = '<p class="dashboard-empty">No Fun Vault videos yet.</p>';
        return;
    }

    list.innerHTML = videos.map(video => `
        <article class="developer-release-card">
            <video class="dashboard-vault-video" controls playsinline preload="metadata" src="${escapeHtmlAttribute(video.video_url)}"></video>
            <div>
                <span class="eyebrow">${video.is_published ? "PUBLISHED" : "DRAFT"}</span>
                <h3>${escapeHtml(video.title)}</h3>
                <p>${escapeHtml(video.description || "")}</p>
            </div>

            <button
                type="button"
                class="secondary-btn"
                onclick="deleteFunVaultVideo('${video.id}')"
            >
                Delete
            </button>
        </article>
    `).join("");
}

async function saveFunVaultVideo() {
    const titleInput = document.getElementById("fun-vault-title");
    const descriptionInput = document.getElementById("fun-vault-description");
    const videoInput = document.getElementById("fun-vault-video-input");
    const publishedInput = document.getElementById("fun-vault-published");
    const message = document.getElementById("fun-vault-save-message");
    const button = document.getElementById("save-fun-vault-button");

    const title = titleInput?.value.trim();
    const description = descriptionInput?.value.trim() || "";
    const videoFile = videoInput?.files?.[0];
    const isPublished = publishedInput?.checked ?? true;

    if (!title) {
        if (message) message.textContent = "Please enter a video title.";
        return;
    }

    if (!videoFile) {
        if (message) message.textContent = "Please choose a video file.";
        return;
    }

    const { data: { user }, error: userError } = await supabase.auth.getUser();

    if (userError || !user) {
        if (message) message.textContent = "Developer session not found.";
        return;
    }

    if (button) {
        button.disabled = true;
        button.textContent = "Uploading...";
    }

    const fileExtension =
        videoFile.name.split(".").pop()?.toLowerCase() || "mp4";

    const filePath =
        `${user.id}/${crypto.randomUUID()}.${fileExtension}`;

    const { error: uploadError } = await supabase.storage
        .from("fun-vault-videos")
        .upload(filePath, videoFile, {
            upsert: false,
            contentType: videoFile.type
        });

    if (uploadError) {
        console.error("Fun Vault upload error:", uploadError);

        if (message) {
            message.textContent = "Could not upload the video.";
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Upload Fun Vault Video";
        }

        return;
    }

    const { data: publicUrlData } = supabase.storage
        .from("fun-vault-videos")
        .getPublicUrl(filePath);

    const videoUrl = publicUrlData?.publicUrl;

    if (!videoUrl) {
        if (message) {
            message.textContent = "Video uploaded, but its URL could not be created.";
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Upload Fun Vault Video";
        }

        return;
    }

    const { error: insertError } = await supabase
        .from("fun_vault_videos")
        .insert({
            title,
            description,
            video_url: videoUrl,
            thumbnail_url: "",
            is_published: isPublished
        });

    if (insertError) {
        console.error("Save Fun Vault video error:", insertError);

        if (message) {
            message.textContent = "Video uploaded, but its information could not be saved.";
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Upload Fun Vault Video";
        }

        return;
    }

    if (message) {
        message.textContent = "Fun Vault video uploaded successfully!";
    }

    if (titleInput) titleInput.value = "";
    if (descriptionInput) descriptionInput.value = "";
    if (videoInput) videoInput.value = "";

    if (button) {
        button.disabled = false;
        button.textContent = "Upload Fun Vault Video";
    }

    await loadFunVaultVideos();
}

async function deleteFunVaultVideo(videoId) {
    if (!videoId) return;

    const confirmed = window.confirm(
        "Delete this Fun Vault video?"
    );

    if (!confirmed) return;

    const { data: video, error: videoError } = await supabase
        .from("fun_vault_videos")
        .select("video_url")
        .eq("id", videoId)
        .single();

    if (videoError) {
        console.error("Find Fun Vault video error:", videoError);
        return;
    }

    const videoUrl = video?.video_url || "";
    const marker = "/storage/v1/object/public/fun-vault-videos/";

    if (videoUrl.includes(marker)) {
        const filePath = decodeURIComponent(
            videoUrl.split(marker)[1]
        );

        const { error: storageError } = await supabase.storage
            .from("fun-vault-videos")
            .remove([filePath]);

        if (storageError) {
            console.error("Delete Fun Vault file error:", storageError);
        }
    }

    const { error: deleteError } = await supabase
        .from("fun_vault_videos")
        .delete()
        .eq("id", videoId);

    if (deleteError) {
        console.error("Delete Fun Vault database record error:", deleteError);
        return;
    }

    await loadFunVaultVideos();
}

