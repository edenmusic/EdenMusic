async function editSongLyrics(songId) {
    const editor = document.getElementById("lyrics-editor");
    const titleElement = document.getElementById("lyrics-editor-title");
    const lyricsInput = document.getElementById("lyrics-editor-input");
    const message = document.getElementById("lyrics-editor-message");

    if (!editor || !titleElement || !lyricsInput) return;

    const { data: song, error } = await supabase
        .from("song")
        .select("id, title, lyrics")
        .eq("id", songId)
        .single();

    if (error) {
        console.error("Load lyrics error:", error);
        alert("Could not load the song lyrics.");
        return;
    }

    editor.dataset.songId = song.id;
    titleElement.textContent = "Edit Lyrics — " + song.title;
    lyricsInput.value = song.lyrics || "";

    if (message) message.textContent = "";

    editor.style.display = "block";
    editor.scrollIntoView({ behavior: "smooth", block: "start" });
}

