let dynamicTrackDatabase = {};
let activelyPlayingTrackId = null;
let loadedTracks = [];

// Load songs from Supabase
async function loadSongsFromSupabase() {
    const { data, error } = await supabase
        .from("song")
        .select("*")
        .order("title");

    if (error) {
        console.error(
            "Supabase songs error:",
            JSON.stringify(error, null, 2)
        );
        return;
    }

    loadedTracks = data.map(song => ({ id: song.id, title: song.title, artist: song.artist || "Eden", duration: song.duration, audioUrl: song.audio_url, coverUrl: song.cover_url, videoUrl: song.video_url || "", lyrics: song.lyrics || "" }));
    data.forEach(song => {
        const track = {
            id: song.id,
            title: song.title,
            artist: song.artist || "Eden",
            duration: song.duration,
            audioUrl: song.audio_url,
            coverUrl: song.cover_url,
            videoUrl: song.video_url || "",
            lyrics: song.lyrics || "",
        };

        // Allow lookup by both UUID and title
        dynamicTrackDatabase[song.id] = track;
        dynamicTrackDatabase[song.title] = track; dynamicTrackDatabase[song.title.toLowerCase()] = track;
    });

    console.log("Songs loaded from Supabase:", data);
    console.log("EDEN SONG DATA:", JSON.stringify(data, null, 2));
    console.log("EDEN VIDEO FROM DATABASE:", JSON.stringify(data.map(song => ({ title: song.title, video_url: song.video_url })), null, 2));
    renderSongList();
}
// Media Streaming Node Interceptor State Events
function renderSongList() {
    const songList = document.getElementById("song-list");
    const songCount = document.getElementById("song-count");

    if (!songList) return;

    songList.innerHTML = loadedTracks.map((track, index) => {
        const minutes = Math.floor((track.duration || 0) / 60);
        const seconds = Math.floor((track.duration || 0) % 60).toString().padStart(2, "0");
        const duration = track.duration ? `${minutes}:${seconds}` : "--:--";
        const cover = track.coverUrl
            ? `<img src="${track.coverUrl}" alt="${track.title} cover">`
            : "🎵";

        return `<article class="song-row" data-title="${track.title}">
            <div class="song-number">${String(index + 1).padStart(2, "0")}</div>
            <div class="song-cover">${cover}</div>
            <div class="song-details">
                <h3>${track.title}</h3>
                <p>${track.artist} • R&B</p>
            </div>
            <span class="song-duration">${duration}</span>
            <button class="song-play" onclick="playSong('${track.id}')">▶</button>
        </article>`;
    }).join("");

    if (songCount) {
        songCount.textContent = `${loadedTracks.length} ${loadedTracks.length === 1 ? "song" : "songs"}`;
    }
}

async function checkDeveloperSession() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session?.user) return;

    const { data: profile, error } = await supabase
        .from("profiles")
        .select("role, display_name")
        .eq("user_id", session.user.id)
        .single();

    developerUserId = session.user.id;
    if (error || profile?.role !== "developer") {
        await supabase.auth.signOut();
        return;
    }

    const loginPanel = document.getElementById("developer-login");
    const dashboardHeader = document.getElementById("developer-dashboard-header");
    const controls = document.getElementById("developer-controls");

    if (loginPanel) loginPanel.style.display = "none";
    if (dashboardHeader) dashboardHeader.style.display = "block";
    if (controls) controls.style.display = "flex";
    loadDeveloperReleases();
    loadDeveloperProfile();
    loadFunVaultVideos();
}


document.addEventListener("DOMContentLoaded", () => {
    loadPublicReels();
    loadFanAccount();
    checkDeveloperSession();

    const progressBar = document.getElementById("player-progress");
    const currentTimeDisplay = document.getElementById("player-current-time");
    const durationDisplay = document.getElementById("player-duration");

    function formatTime(seconds) {
        if (!Number.isFinite(seconds)) return "0:00";
        const minutes = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60).toString().padStart(2, "0");
        return minutes + ":" + secs;
    }

    const audio = document.getElementById("audio-player");
    const video = document.getElementById("player-video");
    const playButton = document.getElementById("main-play-button");
    const visualizer = document.getElementById("visualizer");

    function getActiveMedia() {
        if (video && video.src && !video.paused) return video;
        if (video && video.src && !audio?.src) return video;
        return audio;
    }

    function updatePlayerDisplay(media) {
        if (!media) return;

        if (progressBar) {
            progressBar.max = Number.isFinite(media.duration) ? media.duration : 0;
            progressBar.value = media.currentTime || 0;
        }

        if (currentTimeDisplay) {
            currentTimeDisplay.textContent = formatTime(media.currentTime);
        }

        if (durationDisplay) {
            durationDisplay.textContent = formatTime(media.duration);
        }
    }

    function handlePlay() {
        if (playButton) playButton.textContent = "⏸";
        if (visualizer) visualizer.classList.add("playing");
    }

    function handlePause() {
        if (playButton) playButton.textContent = "▶";
        if (visualizer) visualizer.classList.remove("playing");
    }

    function handleEnded() {
        if (loadedTracks.length > 1) {
            nextSong();
        } else {
            handlePause();
        }
    }

    [audio, video].forEach(media => {
        if (!media) return;

        media.addEventListener("loadedmetadata", () => {
            updatePlayerDisplay(media);
        });

        media.addEventListener("timeupdate", () => {
            if (getActiveMedia() === media) {
                updatePlayerDisplay(media);
            }
        });

        media.addEventListener("play", handlePlay);
        media.addEventListener("pause", handlePause);
        media.addEventListener("ended", handleEnded);
    });

    if (progressBar) {
        progressBar.addEventListener("input", () => {
            const activeMedia = getActiveMedia();
            if (activeMedia) {
                activeMedia.currentTime = Number(progressBar.value);
            }
        });
    }

    loadSongsFromSupabase();
});

