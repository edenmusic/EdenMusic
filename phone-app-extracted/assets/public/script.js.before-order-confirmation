// 2. Playback Ingest Automation System
function playSong(trackId) {
    let track = dynamicTrackDatabase[trackId] || dynamicTrackDatabase[String(trackId).toLowerCase()];

    if (!track) {
        track = {
            id: trackId,
            title: trackId,
            artist: "Eden"
        };
    }

    activelyPlayingTrackId = track.id;
    console.log("EDEN PLAY TRACK:", track);
    console.log("EDEN VIDEO URL:", track.videoUrl);
    console.log("EDEN FULL TRACK:", JSON.stringify(track, null, 2));

    const player = document.getElementById("song-player");
    const audio = document.getElementById("audio-player");
    const title = document.getElementById("player-title");
    const artist = document.getElementById("player-artist");
    const cover = document.getElementById("player-cover");
    const lyricsElement = document.getElementById("player-lyrics-text");
    const videoContainer = document.getElementById("player-video-container");
    const video = document.getElementById("player-video");

    if (player) {
        player.classList.add("active");
    }

    if (title) {
        title.textContent = track.title;
    }

    if (artist) {
        artist.textContent = track.artist || "Eden";
    }

    if (lyricsElement) {
        lyricsElement.textContent = track.lyrics || "Lyrics will appear here.";
    }

    if (cover) {
        if (track.coverUrl) {
            cover.innerHTML = `<img src="${track.coverUrl}" alt="${track.title} cover">`;
        } else {
            cover.textContent = "🎵";
        }
    }

if (video && videoContainer) {
    video.pause();
    video.removeAttribute("src");
    video.load();
    videoContainer.style.display = "none";
}

if (audio) {
    audio.pause();
    audio.removeAttribute("src");
    audio.load();
}

if (track.videoUrl && video && videoContainer) {
    videoContainer.style.display = "block";
    video.src = track.videoUrl;
    video.load();

    video.play().catch(error => {
        console.error("Video playback error:", error);
    });
} else if (audio && track.audioUrl) {
    audio.src = track.audioUrl;
    audio.load();

    audio.play().catch(error => {
        console.error("Audio playback error:", error);
    });
}

document.body.classList.add("player-open");

    renderLyricsDisplay(track.id);
}

// 3. Media Ingestion Node Engine (Artist Dashboard Preference)
let developerUserId = null;
async function developerLogin() {
    const emailInput = document.getElementById("developer-email");
    const passwordInput = document.getElementById("developer-password");
    const message = document.getElementById("developer-login-message");
    const button = document.getElementById("developer-login-button");

    const email = emailInput?.value.trim();
    const password = passwordInput?.value;

    if (!email || !password) {
        if (message) message.textContent = "Enter your email and password.";
        return;
    }

    if (button) {
        button.disabled = true;
        button.textContent = "Signing in...";
    }

    const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password
    });

    if (error) {
        console.error("Developer login error:", error);
        if (message) message.textContent = "Login failed. Check your credentials.";

        if (button) {
            button.disabled = false;
            button.textContent = "Developer Login";
        }
        return;
    }

    const userId = data.user?.id;
    developerUserId = userId;

    const { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("role, display_name")
        .eq("user_id", userId)
        .single();

    if (profileError || profile?.role !== "developer") {
        await supabase.auth.signOut();
        if (message) message.textContent = "This account is not authorized as a developer.";

        if (button) {
            button.disabled = false;
            button.textContent = "Developer Login";
        }
        return;
    }

    if (message) message.textContent = `Welcome, ${profile.display_name || "Developer"}.`;

    document.getElementById("developer-login").style.display = "none";
    document.getElementById("developer-dashboard-header").style.display = "block";
    document.getElementById("developer-controls").style.display = "flex";
    await loadDeveloperProfile();
    await loadFunVaultVideos();

    if (button) {
        button.disabled = false;
        button.textContent = "Developer Login";
    }
}

window.developerLogin = developerLogin;

