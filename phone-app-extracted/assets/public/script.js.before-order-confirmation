async function getFanVaultEngagement(videoId) {
    if (!videoId) {
        return { likes: 0, comments: 0, saves: 0, liked: false, saved: false };
    }

    const { data: { user } } = await supabase.auth.getUser();

    const [
        { count: likeCount, error: likeError },
        { count: commentCount, error: commentError },
        { count: saveCount, error: saveError }
    ] = await Promise.all([
        supabase
            .from("fun_vault_likes")
            .select("*", { count: "exact", head: true })
            .eq("video_id", videoId),

        supabase
            .from("fun_vault_comments")
            .select("*", { count: "exact", head: true })
            .eq("video_id", videoId),

        supabase
            .from("fun_vault_saves")
            .select("*", { count: "exact", head: true })
            .eq("video_id", videoId)
    ]);

    if (likeError) console.error("Like count error:", likeError);
    if (commentError) console.error("Comment count error:", commentError);
    if (saveError) console.error("Save count error:", saveError);

    let liked = false;
    let saved = false;

    if (user) {
        const [
            { data: userLike, error: userLikeError },
            { data: userSave, error: userSaveError }
        ] = await Promise.all([
            supabase
                .from("fun_vault_likes")
                .select("id")
                .eq("video_id", videoId)
                .eq("user_id", user.id)
                .maybeSingle(),

            supabase
                .from("fun_vault_saves")
                .select("id")
                .eq("video_id", videoId)
                .eq("user_id", user.id)
                .maybeSingle()
        ]);

        if (userLikeError) console.error("User like state error:", userLikeError);
        if (userSaveError) console.error("User save state error:", userSaveError);

        liked = !!userLike;
        saved = !!userSave;
    }

    return {
        likes: likeCount || 0,
        comments: commentCount || 0,
        saves: saveCount || 0,
        liked,
        saved
    };
}


