async function loadFanVaultMerchandise() {
    const container = document.getElementById("fan-vault-merch-grid");

    if (!container) return;

    const { data: merch, error } = await supabase
        .from("merchandise")
        .select("id, name, description, price, currency, image_url, stock, is_preorder")
        .eq("is_available", true)
        .order("created_at", { ascending: false });

    if (error) {
        console.error("Load merchandise error:", error);
        container.innerHTML = `
            <p class="dashboard-empty">
                Merchandise is currently unavailable.
            </p>
        `;
        return;
    }

    if (!merch?.length) {
        container.innerHTML = `
            <p class="dashboard-empty">
                No merchandise available yet.
            </p>
        `;
        return;
    }

    container.innerHTML = merch.map(item => `
        <article class="fan-vault-merch-card">

            <div class="fan-vault-merch-image">
                ${
                    item.image_url
                    ? `<img src="${item.image_url}" alt="${item.name}">`
                    : `<span>🛍️</span>`
                }
            </div>

            <div class="fan-vault-merch-info">
                <h4>${item.name}</h4>

                <p>${item.description || ""}</p>

                <strong>
                    ${item.currency} ${Number(item.price).toLocaleString()}
                </strong>

                ${
                    item.is_preorder
                    ? `<span class="fan-vault-preorder-badge">PRE-ORDER</span>`
                    : ""
                }

                <button
                    type="button"
                    class="primary-btn"
                    onclick="startMerchPreorder('${item.id}')"
                >
                    ${item.is_preorder ? "Pre-order" : "Buy Now"}
                </button>
            </div>

        </article>
    `).join("");
}


async function startMerchPreorder(merchId) {
    if (!merchId) return;

    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
        openFanAccountScreen();
        return;
    }

    const { data: item, error } = await supabase
        .from("merchandise")
        .select("id, name, price, currency, stock")
        .eq("id", merchId)
        .single();

    if (error || !item) {
        console.error("Load merch item error:", error);
        showMessage("Could not load this merchandise item.");
        return;
    }

    let panel = document.getElementById("merch-checkout-panel");

    if (!panel) {
        panel = document.createElement("div");
        panel.id = "merch-checkout-panel";
        document.body.appendChild(panel);
    }

    panel.innerHTML = `
        <div class="merch-checkout-overlay" onclick="closeMerchCheckout()"></div>
        <div class="merch-checkout-sheet">
            <div class="merch-checkout-header">
                <div>
                    <span class="eyebrow">EDEN MUSIC</span>
                    <h3>Pre-order</h3>
                </div>
                <button type="button" onclick="closeMerchCheckout()">✕</button>
            </div>

            <div class="merch-checkout-product">
                <h4>${item.name}</h4>
                <p>${item.currency} ${Number(item.price).toLocaleString()} each</p>
            </div>

            <form id="merch-checkout-form">
                <label>Quantity
                    <input id="merch-quantity" type="number" min="1" value="1" required>
                </label>

                <label>Full name
                    <input id="merch-customer-name" type="text" required>
                </label>

                <label>Phone number
                    <input id="merch-phone" type="tel" required>
                </label>

                <label>Delivery address
                    <textarea id="merch-address" rows="3" required></textarea>
                </label>

                <div class="merch-payment-methods">
                    <strong>Payment method</strong>
                    <label class="merch-payment-option">
                        <input type="radio" name="merch-payment-method" value="mpesa" required>
                        <span>📱 M-Pesa</span>
                    </label>
                    <label class="merch-payment-option">
                        <input type="radio" name="merch-payment-method" value="airtel_money">
                        <span>📱 Airtel Money</span>
                    </label>
                    <label class="merch-payment-option">
                        <input type="radio" name="merch-payment-method" value="card">
                        <span>💳 Card</span>
                    </label>
                </div>

                <div class="merch-checkout-total">
                    <span>Total</span>
                    <strong id="merch-checkout-total">${item.currency} ${Number(item.price).toLocaleString()}</strong>
                </div>

                <button type="submit" class="primary-btn">
                    Continue to Payment
                </button>
            </form>
        </div>
    `;

    panel.classList.add("active");

    document.getElementById("merch-checkout-form").addEventListener("submit", async event => {
        event.preventDefault();

        const quantity = Number(document.getElementById("merch-quantity").value);
        const customerName = document.getElementById("merch-customer-name").value.trim();
        const phone = document.getElementById("merch-phone").value.trim();
        const deliveryAddress = document.getElementById("merch-address").value.trim();
        const paymentMethod = document.querySelector('input[name="merch-payment-method"]:checked')?.value;

        if (!quantity || !customerName || !phone || !deliveryAddress || !paymentMethod) {
            showMessage("Please complete all fields.");
            return;
        }

        const totalAmount = Number(item.price) * quantity;

        const { data: order, error: orderError } = await supabase
            .from("merch_orders")
            .insert({
                user_id: user.id,
                merchandise_id: item.id,
                quantity,
                customer_name: customerName,
                phone,
                delivery_address: deliveryAddress,
                total_amount: totalAmount,
                currency: item.currency,
                payment_status: "pending",
                payment_method: paymentMethod,
                order_status: "pending"
            })
            .select("id")
            .single();

        if (orderError) {
            console.error("Create merch order error:", orderError);
            showMessage("Could not create your order.");
            return;
        }

        closeMerchCheckout();
        showMessage("Order created. Payment connection comes next.");
        console.log("Merch order created:", order.id, paymentMethod);
    });
}

function closeMerchCheckout() {
    const panel = document.getElementById("merch-checkout-panel");
    if (panel) panel.classList.remove("active");
}

