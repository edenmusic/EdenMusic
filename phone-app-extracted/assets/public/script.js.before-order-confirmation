async function shareFunVaultVideo(videoId) {
    if (!videoId) return;

    const shareUrl = `${window.location.origin}${window.location.pathname}?fun_vault=${encodeURIComponent(videoId)}`;

    const shareData = {
        title: "Eden Music — Fan Vault",
        text: "Check out this exclusive Fan Vault video on Eden Music.",
        url: shareUrl
    };

    try {
        if (navigator.share) {
            await navigator.share(shareData);
            return;
        }

        await navigator.clipboard.writeText(shareUrl);
        alert("Fan Vault video link copied!");
    } catch (error) {
        if (error?.name !== "AbortError") {
            console.error("Share error:", error);
        }
    }
}

