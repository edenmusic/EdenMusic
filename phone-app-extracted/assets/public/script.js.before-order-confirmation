async function loginFanAccount() {
    const emailInput = document.getElementById("fan-login-email");
    const passwordInput = document.getElementById("fan-login-password");
    const message = document.getElementById("fan-login-message");
    const button = document.getElementById("fan-login-button");

    const email = emailInput?.value.trim();
    const password = passwordInput?.value;

    if (!email || !password) {
        if (message) message.textContent = "Enter your email and password.";
        return;
    }

    if (button) {
        button.disabled = true;
        button.textContent = "Signing in...";
    }

    const { data, error } = await supabase.auth.signInWithPassword({
        email,
        password
    });

    if (error) {
        console.error("Fan login error:", error);

        if (message) {
            message.textContent = error.message;
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Sign In";
        }

        return;
    }

    const user = data?.user;

    if (!user) {
        if (message) {
            message.textContent = "Login failed.";
        }

        if (button) {
            button.disabled = false;
            button.textContent = "Sign In";
        }

        return;
    }
    let { data: profile, error: profileError } = await supabase
        .from("profiles")
        .select("user_id, display_name, role")
        .eq("user_id", user.id)
        .maybeSingle();

    if (profileError) {
        console.error("Fan profile lookup error:", profileError);

        if (message) message.textContent = "Could not check your fan profile.";

        if (button) {
            button.disabled = false;
            button.textContent = "Sign In";
        }

        return;
    }

    if (!profile) {
        const displayName = user.email?.split("@")[0] || "Fan";

        const { data: newProfile, error: createProfileError } = await supabase
            .from("profiles")
            .insert({
                user_id: user.id,
                display_name: displayName,
                bio: "",
                avatar_url: "",
                role: "fan"
            })
            .select("user_id, display_name, role")
            .single();

        if (createProfileError) {
            console.error("Fan profile creation after login error:", createProfileError);

            if (message) message.textContent = "Your account is confirmed, but your fan profile could not be created.";

            if (button) {
                button.disabled = false;
                button.textContent = "Sign In";
            }

            return;
        }

        profile = newProfile;
    }

    if (profile.role !== "fan") {
        await supabase.auth.signOut();

        if (message) message.textContent = "This account is not registered as a fan account.";

        if (button) {
            button.disabled = false;
            button.textContent = "Sign In";
        }

        return;
    }
    if (passwordInput) passwordInput.value = "";

    if (button) {
        button.disabled = false;
        button.textContent = "Sign In";
    }

    await loadFanAccount();
}

