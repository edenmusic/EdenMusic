    const audioInput = document.getElementById("edit-song-audio");
    const coverInput = document.getElementById("edit-song-cover");
    const videoInput = document.getElementById("edit-song-video");
    const lyricsInput = document.getElementById("edit-song-lyrics");
    const message = document.getElementById("song-editor-message");

    if (titleInput) titleInput.value = "";
    if (artistInput) artistInput.value = "Eden";
    if (audioInput) audioInput.value = "";
    if (coverInput) coverInput.value = "";
    if (videoInput) videoInput.value = "";
    if (lyricsInput) lyricsInput.value = "";
    if (message) message.textContent = "";
}

window.saveEditedSong = saveEditedSong;
window.cancelSongEdit = cancelSongEdit;
async function loadPublicReels() {
    const container = document.getElementById("public-reels-container");

    if (!container) return;

    const { data: videos, error } = await supabase
        .from("fun_vault_videos")
        .select("id, title, description, video_url, thumbnail_url, created_at")
        .eq("is_published", true)
        .order("created_at", { ascending: false })
        .limit(5);

    if (error) {
        console.error("Public Fun Vault videos error:", error);
        container.innerHTML =
            '<p class="dashboard-empty">Could not load reels.</p>';
        return;
    }

    if (!videos?.length) {
        container.innerHTML =
            '<p class="dashboard-empty">No reels available yet.</p>';
        return;
    }

    container.innerHTML = videos.map(video => `
        <article class="reel-card">
            <video
                class="public-reel-video"
                controls
                preload="metadata"
                ${video.thumbnail_url ? `poster="${escapeHtmlAttribute(video.thumbnail_url)}"` : ""}
            >
                <source src="${escapeHtmlAttribute(video.video_url)}" type="video/mp4">
                Your browser does not support video playback.
            </video>

            <div class="reel-overlay">
                <span>FUN VAULT</span>
                <h3>${escapeHtml(video.title)}</h3>
                ${
                    video.description
                        ? `<p>${escapeHtml(video.description)}</p>`
                        : ""
                }
            </div>
        </article>
    `).join("");
}

window.loadPublicReels = loadPublicReels;
