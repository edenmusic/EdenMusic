async function saveSongToSupabase() {
    const titleInput = document.getElementById("song-title-input");
    const artistInput = document.getElementById("song-artist-input");
    const audioInput = document.getElementById("song-audio-input");
    const coverInput = document.getElementById("song-cover-input");
    const videoInput = document.getElementById("song-video-input");
    const lyricsInput = document.getElementById("song-lyrics-input");
    const saveButton = document.getElementById("save-song-button");

    const title = titleInput?.value.trim();
    const artist = artistInput?.value.trim() || "Eden";
    const audioFile = audioInput?.files[0];
    const coverFile = coverInput?.files[0];
    const videoFile = videoInput?.files[0];
    const lyrics = lyricsInput?.value.trim() || "";

    if (!title) {
        alert("Please enter a song title.");
        return;
    }

    if (!audioFile) {
        alert("Please select an audio file.");
        return;
    }

    if (!coverFile) {
        alert("Please select cover artwork.");
        return;
    }

    try {
        if (saveButton) {
            saveButton.disabled = true;
            saveButton.textContent = "Uploading...";
        }

        const safeTitle = title
            .replace(/[^a-zA-Z0-9-_]/g, "_")
            .replace(/_+/g, "_");

        const timestamp = Date.now();

        const audioPath = `${timestamp}_${safeTitle}${audioFile.name.substring(audioFile.name.lastIndexOf("."))}`;
        const coverPath = `${timestamp}_${safeTitle}_cover${coverFile.name.substring(coverFile.name.lastIndexOf("."))}`;

        const { error: audioUploadError } = await supabase
            .storage
            .from("songs")
            .upload(audioPath, audioFile, {
                cacheControl: "3600",
                upsert: false
            });

        if (audioUploadError) {
            throw audioUploadError;
        }

        const { error: coverUploadError } = await supabase
            .storage
            .from("songs")
            .upload(coverPath, coverFile, {
                cacheControl: "3600",
                upsert: false
            });

        if (coverUploadError) {
            throw coverUploadError;
        }

        let videoUrl = "";

        if (videoFile) {
            const videoExtension = videoFile.name.substring(videoFile.name.lastIndexOf("."));
            const videoPath = `${timestamp}_${safeTitle}_video${videoExtension}`;

            const { error: videoUploadError } = await supabase
                .storage
                .from("songs")
                .upload(videoPath, videoFile, {
                    cacheControl: "3600",
                    upsert: false
                });

            if (videoUploadError) {
                throw videoUploadError;
            }

            const { data: videoPublicData } = supabase
                .storage
                .from("songs")
                .getPublicUrl(videoPath);

            videoUrl = videoPublicData.publicUrl;
        }

        const { data: audioPublicData } = supabase
            .storage
            .from("songs")
            .getPublicUrl(audioPath);

        const { data: coverPublicData } = supabase
            .storage
            .from("songs")
            .getPublicUrl(coverPath);

        const audioUrl = audioPublicData.publicUrl;
        const coverUrl = coverPublicData.publicUrl;

        const audio = new Audio();
        audio.src = audioUrl;

        const duration = await new Promise((resolve, reject) => {
            audio.addEventListener("loadedmetadata", () => {
                resolve(Math.round(audio.duration));
            });

            audio.addEventListener("error", () => {
                resolve(0);
            });
        });

        const { error: insertError } = await supabase
            .from("song")
            .insert({
                title: title,
                artist: artist,
                duration: duration,
                audio_url: audioUrl,
                cover_url: coverUrl,
                video_url: videoUrl,
                lyrics: lyrics
            });

        if (insertError) {
            throw insertError;
        }

        alert("Song saved successfully!");

        titleInput.value = "";
        artistInput.value = "Eden";
        audioInput.value = "";
        coverInput.value = "";
        lyricsInput.value = "";

        await loadSongsFromSupabase();

    } catch (error) {
        console.error("Save song error:", error);
        alert("Could not save the song. Check the browser console for details.");
    } finally {
        if (saveButton) {
            saveButton.disabled = false;
            saveButton.textContent = "Save Song";
        }
    }
}

function handleFileUpload(event) {
    const file = event.target.files[0];
    if (!file) return;

    const audioUrl = URL.createObjectURL(file);
    const cleanTitle = file.name.replace(/\.[^/.]+$/, "");
    const trackId = "track_" + Date.now();
    
    // Scrape running data cache context fields from manual layout text fields
    const typedLyrics = document.getElementById('manual-lyrics-input').value.trim();

    // Map properties structural dataset mapping configurations directly
    dynamicTrackDatabase[trackId] = {
        id: trackId,
        title: cleanTitle,
        audioUrl: audioUrl,
        lyrics: typedLyrics || ""
    };

    const noSongsMsg = document.getElementById('no-songs-msg');
    if (noSongsMsg) { noSongsMsg.remove(); }

    const songListContainer = document.getElementById('dynamic-song-list');
    const newButton = document.createElement('button');
    newButton.className = 'song-btn';
    newButton.id = `btn_${trackId}`;
    newButton.innerHTML = `🎵 ${cleanTitle}`;
    
    newButton.onclick = function() {
        playSong(trackId);
    };

    songListContainer.appendChild(newButton);
    playSong(trackId);
}
// 4. Custom Manual Lyrics Update Implementation Engine
function saveManualLyrics() {
    const lyricsText = document.getElementById('manual-lyrics-input').value.trim();
    
    if (!activelyPlayingTrackId) {
        alert("Please load or play a track first using Step 1 before assigning manual lyrics to it!");
        return;
    }

    // Write directly into internal variable memory configuration cache layer
    dynamicTrackDatabase[activelyPlayingTrackId].lyrics = lyricsText;
    
    // Command instant refresh layout cycles
    renderLyricsDisplay(activelyPlayingTrackId);
    alert("Lyrics updated successfully for the current track!");
}

// Layout Presentation Transform Engine Layer
function renderLyricsDisplay(trackId) {
    const track = dynamicTrackDatabase[trackId];

    const lyricsBox = document.getElementById('active-lyrics-display');
    const lyricsTextElement = document.getElementById('active-lyrics-text');
    const manualLyricsInput = document.getElementById('manual-lyrics-input');

    // The current Music screen does not have the old lyrics elements.
    // Don't let that stop the player from opening.
    if (!lyricsBox || !lyricsTextElement) {
        return;
    }

    if (track && track.lyrics) {
        lyricsBox.classList.remove('hidden');
        lyricsTextElement.innerHTML = track.lyrics.replace(/\n/g, '<br>');

        if (manualLyricsInput) {
            manualLyricsInput.value = track.lyrics;
        }
    } else {
        lyricsBox.classList.add('hidden');
        lyricsTextElement.innerHTML = '';
    }
}

