    }

    if (!links?.length) {
        const emptyMessage = document.createElement("p");
        emptyMessage.textContent = "Social links coming soon.";
        socialContainer.appendChild(emptyMessage);
        return;
    }

    links.forEach(link => {
        const anchor = document.createElement("a");

        anchor.href = link.profile_url;
        anchor.target = "_blank";
        anchor.rel = "noopener";
        anchor.textContent = link.platform_name;

