async function saveEditedSong() {
    const editor = document.getElementById("song-editor");
    const titleInput = document.getElementById("edit-song-title");
    const artistInput = document.getElementById("edit-song-artist");
    const audioInput = document.getElementById("edit-song-audio");
    const coverInput = document.getElementById("edit-song-cover");
    const videoInput = document.getElementById("edit-song-video");
    const lyricsInput = document.getElementById("edit-song-lyrics");
    const message = document.getElementById("song-editor-message");
    const button = document.getElementById("save-song-edit-button");

    if (!editor || !titleInput || !artistInput || !lyricsInput) return;

    const songId = editor.dataset.songId;
    const title = titleInput.value.trim();
    const artist = artistInput.value.trim() || "Eden";
    const lyrics = lyricsInput.value;

    const audioFile = audioInput?.files[0];
    const coverFile = coverInput?.files[0];
    const videoFile = videoInput?.files[0];

    if (!songId) {
        if (message) message.textContent = "No song selected.";
        return;
    }

    if (!title) {
        if (message) message.textContent = "Song title is required.";
        return;
    }

    try {
        if (button) {
            button.disabled = true;
            button.textContent = "Saving...";
        }

        if (message) {
            message.textContent = "Saving song changes...";
        }

        const updateData = {
            title: title,
            artist: artist,
            lyrics: lyrics
        };

        if (audioFile) {
            const safeTitle = title
                .replace(/[^a-zA-Z0-9-_]/g, "_")
                .replace(/_+/g, "_");

            const timestamp = Date.now();

            const audioExtension =
                audioFile.name.substring(audioFile.name.lastIndexOf("."));

            const audioPath =
                `${timestamp}_${safeTitle}_audio${audioExtension}`;

            const { error: audioUploadError } = await supabase
                .storage
                .from("songs")
                .upload(audioPath, audioFile, {
                    cacheControl: "3600",
                    upsert: false
                });

            if (audioUploadError) {
                throw audioUploadError;
            }

        let videoUrl = "";

        if (videoFile) {
            const videoExtension = videoFile.name.substring(videoFile.name.lastIndexOf("."));
            const videoPath = `${timestamp}_${safeTitle}_video${videoExtension}`;

            const { error: videoUploadError } = await supabase
                .storage
                .from("songs")
                .upload(videoPath, videoFile, {
                    cacheControl: "3600",
                    upsert: false
                });

            if (videoUploadError) {
                throw videoUploadError;
            }

            const { data: videoPublicData } = supabase
                .storage
                .from("songs")
                .getPublicUrl(videoPath);

            videoUrl = videoPublicData.publicUrl;
        }

            const { data: audioPublicData } = supabase
                .storage
                .from("songs")
                .getPublicUrl(audioPath);

            updateData.audio_url = audioPublicData.publicUrl;

            const audio = new Audio();
            audio.src = audioPublicData.publicUrl;

            updateData.duration = await new Promise(resolve => {
                audio.addEventListener("loadedmetadata", () => {
                    resolve(Math.round(audio.duration));
                });

                audio.addEventListener("error", () => {
                    resolve(0);
                });
            });
        }

        if (coverFile) {
            const safeTitle = title
                .replace(/[^a-zA-Z0-9-_]/g, "_")
                .replace(/_+/g, "_");

            const timestamp = Date.now();

            const coverExtension =
                coverFile.name.substring(coverFile.name.lastIndexOf("."));

            const coverPath =
                `${timestamp}_${safeTitle}_cover${coverExtension}`;

            const { error: coverUploadError } = await supabase
                .storage
                .from("songs")
                .upload(coverPath, coverFile, {
                    cacheControl: "3600",
                    upsert: false
                });

            if (coverUploadError) {
                throw coverUploadError;
            }

            const { data: coverPublicData } = supabase
                .storage
                .from("songs")
                .getPublicUrl(coverPath);

            updateData.cover_url = coverPublicData.publicUrl;
        }

        if (videoFile) {
            const safeTitle = title
                .replace(/[^a-zA-Z0-9-_]/g, "_")
                .replace(/_+/g, "_");

            const timestamp = Date.now();

            const videoExtension =
                videoFile.name.substring(videoFile.name.lastIndexOf("."));

            const videoPath =
                `${timestamp}_${safeTitle}_video${videoExtension}`;

            const { error: videoUploadError } = await supabase
                .storage
                .from("songs")
                .upload(videoPath, videoFile, {
                    cacheControl: "3600",
                    upsert: false
                });

            if (videoUploadError) {
                throw videoUploadError;
            }

            const { data: videoPublicData } = supabase
                .storage
                .from("songs")
                .getPublicUrl(videoPath);

            updateData.video_url = videoPublicData.publicUrl;
        }

        const { error: updateError } = await supabase
            .from("song")
            .update(updateData)
            .eq("id", songId);

        if (updateError) {
            throw updateError;
        }

        if (message) {
            message.textContent = "Song changes saved successfully!";
        }

        if (audioInput) audioInput.value = "";
        if (coverInput) coverInput.value = "";
    if (videoInput) videoInput.value = "";

        await loadDeveloperReleases();
        await loadSongsFromSupabase();

    } catch (error) {
        console.error("Save edited song error:", error);

        if (message) {
            message.textContent = "Could not save the song changes.";
        }
    } finally {
        if (button) {
            button.disabled = false;
            button.textContent = "Save Song Changes";
        }
    }
}

